# Copy this to .env.local and fill in real values.
# .env.local is gitignored.

# Cloudflare API token — needs scopes:
#   Account: Cloudflare Pages (Edit), Account Settings (Read)
#   Zone:    Zone (Edit), DNS (Edit)
#   User:    User Details (Read)
# Create at https://dash.cloudflare.com/profile/api-tokens
export CF_API_TOKEN="cfut_..."

# Find at dash.cloudflare.com sidebar → API → Account ID
export CF_ACCOUNT_ID="..."

# Zone ID of the parent domain (hsiehting.com)
export CF_ZONE_ID_HSIEHTING="..."

# wrangler reads these env names directly
export CLOUDFLARE_API_TOKEN="$CF_API_TOKEN"
export CLOUDFLARE_ACCOUNT_ID="$CF_ACCOUNT_ID"

# RapidAPI key — used by the `scouting-threads` skill to query
# threads-scraper.p.rapidapi.com for content-pulse research.
# Get one at https://rapidapi.com/  →  subscribe to "Threads Scraper"  →  copy key.
RAPIDAPI_KEY="..."
