---
import "../styles/global.css";
import { Moon, Sun, Braces, Search, Rss, Languages } from "@lucide/astro";
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "@/config";
import Footer from "@/components/Footer.astro";
import BackToTop from "@/components/BackToTop.astro";

interface Props {
    title?: string;
    description?: string;
    type?: string;
    image?: string;
    imageWidth?: number;
    imageHeight?: number;
    imageType?: string;
    imageAlt?: string;
}

const {
    title = siteConfig.title,
    description = siteConfig.description,
    type = "website",
    image,
    imageWidth = 1200,
    imageHeight = 630,
    imageType = "image/png",
    imageAlt,
} = Astro.props;

// Cloudflare Pages serves folder/index.html and 308-redirects bare paths to
// the trailing-slash form. Match that here so canonical never points at a
// redirect target — keep Google's canonical signal intact.
const canonicalPath = (() => {
    const p = Astro.url.pathname;
    if (p === "/") return "/";
    return p.endsWith("/") ? p : `${p}/`;
})();
const canonicalURL = new URL(
    canonicalPath,
    Astro.site || Astro.url.origin,
);

// Pick an OG image for every page. Posts and any caller that passes `image`
// win; otherwise we map well-known pathnames to a hand-rendered page card,
// and fall back to /og/pages/default.png so social previews never go blank.
function resolvePageOg(pathname: string): string {
    const p = pathname.replace(/\/+$/, "") || "/";
    if (p === "/" || p.startsWith("/page/")) return "/og/pages/home.png";
    if (p === "/about") return "/og/pages/about.png";
    if (p === "/cv") return "/og/pages/cv.png";
    if (p === "/tags" || p.startsWith("/tags/")) return "/og/pages/tags.png";
    if (p === "/portfolio") return "/og/pages/portfolio.png";
    return "/og/pages/default.png";
}

const ogImage = image ?? resolvePageOg(Astro.url.pathname);
const ogImageUrl = new URL(ogImage, Astro.site || Astro.url.origin).href;
const ogImageAlt = imageAlt ?? title;
const twitterHandle = (siteConfig.socials.twitter ?? "").replace(
    /^https?:\/\/(www\.)?(twitter|x)\.com\//i,
    "",
);
const twitterAt = twitterHandle ? `@${twitterHandle.replace(/^@/, "")}` : "";

const normalize = (p: string) => p.replace(/\/+$/, "") || "/";

const isOnCurrentPath = (path: string) => {
    const currentPath = normalize(Astro.url.pathname);
    // treat paginated listing pages as part of the home route so the
    // home navigation item remains active on `/page/...` archive pages.
    if (path === "/" && currentPath.startsWith("/page/")) return true;
    return currentPath === normalize(path);
};
---

<html lang="zh-TW">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <ClientRouter />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="canonical" href={canonicalURL.href} />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16.png"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />

        <meta property="og:site_name" content={siteConfig.title} />
        <meta property="og:locale" content="zh_TW" />
        <meta property="og:locale:alternate" content="en_US" />
        <meta property="og:locale:alternate" content="ja_JP" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:type" content={type} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:secure_url" content={ogImageUrl} />
        <meta property="og:image:type" content={imageType} />
        <meta property="og:image:width" content={String(imageWidth)} />
        <meta property="og:image:height" content={String(imageHeight)} />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content={ogImageAlt} />
        {twitterAt && <meta name="twitter:site" content={twitterAt} />}
        {twitterAt && <meta name="twitter:creator" content={twitterAt} />}

        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link
            rel="alternate"
            type="application/rss+xml"
            title={siteConfig.rss.title}
            href={new URL("feed.xml", Astro.url.origin)}
        />

        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "WebSite",
                name: siteConfig.title,
                url: siteConfig.siteUrl,
                inLanguage: "zh-TW",
                description: siteConfig.description,
                publisher: {
                    "@type": "Person",
                    name: siteConfig.author.name,
                    ...(siteConfig.author.specialty && {
                        jobTitle: siteConfig.author.specialty,
                    }),
                    ...(siteConfig.author.affiliation && {
                        affiliation: {
                            "@type": "Organization",
                            name: siteConfig.author.affiliation,
                            ...(siteConfig.author.affiliationUrl && {
                                url: siteConfig.author.affiliationUrl,
                            }),
                        },
                    }),
                    ...(siteConfig.socials.github && {
                        sameAs: [siteConfig.socials.github].filter(Boolean),
                    }),
                },
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Physician",
                name: siteConfig.author.name,
                description: siteConfig.author.bio,
                ...(siteConfig.author.specialty && {
                    medicalSpecialty: siteConfig.author.specialty,
                }),
                ...(siteConfig.author.affiliation && {
                    affiliation: {
                        "@type": "Organization",
                        name: siteConfig.author.affiliation,
                        ...(siteConfig.author.affiliationUrl && {
                            url: siteConfig.author.affiliationUrl,
                        }),
                    },
                }),
                url: siteConfig.siteUrl,
                ...(siteConfig.socials.github && {
                    sameAs: [
                        siteConfig.socials.github,
                        siteConfig.author.orcid,
                        siteConfig.author.scholar,
                    ].filter(Boolean),
                }),
            })}
        />
        <slot name="head" />
        {
            siteConfig.analytics.umami.websiteId &&
                siteConfig.analytics.umami.src && (
                    <script
                        is:inline
                        defer
                        src={siteConfig.analytics.umami.src}
                        data-website-id={siteConfig.analytics.umami.websiteId}
                    />
                )
        }
        <script is:inline>
            const setDarkMode = () => {
                const theme = (() => {
                    if (
                        typeof localStorage !== "undefined" &&
                        localStorage.getItem("theme")
                    ) {
                        return localStorage.getItem("theme");
                    }
                    if (
                        window.matchMedia("(prefers-color-scheme: dark)")
                            .matches
                    ) {
                        return "dark";
                    }
                    return "light";
                })();
                if (theme === "light") {
                    document.documentElement.classList.remove("dark");
                } else {
                    document.documentElement.classList.add("dark");
                }
            };
            setDarkMode();
            document.addEventListener("astro:after-swap", setDarkMode);

            // Global UI language ("zh" | "en" | "ja") — controls visibility
            // of any element with data-lang-only matching the current lang.
            // Default zh-TW; persisted in localStorage under key "site-lang".
            const setLang = () => {
                let lang = "zh";
                try {
                    const saved = localStorage.getItem("site-lang");
                    if (saved === "en" || saved === "zh" || saved === "ja") {
                        lang = saved;
                    }
                } catch {}
                document.documentElement.dataset.lang = lang;
            };
            setLang();
            document.addEventListener("astro:after-swap", setLang);
        </script>
    </head>
    <body class="max-w-page mx-auto min-h-screen flex flex-col">
        <nav
            id="main-nav"
            class="px-4 sm:px-5 py-5 flex items-center justify-between gap-3 sticky top-0 z-50"
        >
            <a
                href="/"
                aria-label={`${siteConfig.title} — 首頁 / Home`}
                class="shrink-0 inline-flex items-center text-foreground hover:text-primary transition-colors"
            >
                <Braces />
            </a>

            <ul class="flex items-center flex-nowrap justify-end gap-x-2 sm:gap-x-4 text-sm sm:text-base min-w-0">
                {
                    siteConfig.nav.map((link) => (
                        <li class="whitespace-nowrap">
                            <a
                                href={link.href}
                                class={
                                    isOnCurrentPath(link.href) ? "active" : ""
                                }
                            >
                                <span
                                    class={
                                        isOnCurrentPath(link.href)
                                            ? ""
                                            : "nav-link"
                                    }
                                >
                                    <span data-lang-only="zh">{link.label}</span>
                                    <span data-lang-only="en">
                                        {link.labelEn ?? link.label}
                                    </span>
                                    <span data-lang-only="ja">
                                        {link.labelJa ?? link.labelEn ?? link.label}
                                    </span>
                                </span>
                            </a>
                        </li>
                    ))
                }
                <li>
                    <button
                        id="lang-toggle"
                        type="button"
                        aria-label="Toggle language"
                        title="切換語言 · Toggle language · 言語切替"
                        class="flex items-center gap-1 text-xs font-medium"
                    >
                        <Languages size={14} />
                        <span data-lang-only="zh">EN</span>
                        <span data-lang-only="en">日</span>
                        <span data-lang-only="ja">中</span>
                    </button>
                </li>
                <li>
                    <button
                        id="theme-toggle"
                        type="button"
                        aria-label="Toggle dark mode"
                        class="flex items-center"
                    >
                        <Moon class="block dark:hidden" size={16} />
                        <Sun class="hidden dark:block" size={16} />
                    </button>
                </li>
                <li class="hidden sm:flex">
                    <a
                        href="/feed.xml"
                        aria-label="RSS feed"
                        class="flex items-center"
                    >
                        <Rss size={16} />
                    </a>
                </li>
                <li>
                    <button
                        id="search-toggle"
                        type="button"
                        aria-label="Open search"
                        class="flex items-center"
                    >
                        <Search size={16} />
                    </button>
                </li>
            </ul>
        </nav>
        <div class="flex-1">
            <slot />
        </div>
        <Footer />
        <BackToTop />
        <div
            id="search-overlay"
            class="fixed inset-0 z-[100] bg-background/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 flex items-start justify-center pt-20 sm:pt-32 px-4 disable-select"
            aria-hidden="true"
            inert
        >
            <div
                id="search-modal"
                class="bg-card w-full max-w-xl rounded-xl border border-border shadow-2xl scale-95 transition-transform duration-300 flex flex-col overflow-hidden max-h-[80vh]"
            >
                <div
                    class="flex items-center px-4 py-3 border-b border-border gap-3"
                >
                    <Search class="text-muted-foreground" size={18} />
                    <input
                        type="text"
                        id="search-input"
                        class="flex-1 bg-transparent border-none outline-none text-foreground placeholder:text-muted-foreground"
                        placeholder="Search posts... (Cmd+K)"
                        autocomplete="off"
                    />
                    <button
                        id="search-close"
                        class="text-xs text-muted-foreground bg-secondary px-2 py-1 rounded hidden sm:block cursor-pointer"
                        >ESC</button
                    >
                </div>
                <div
                    id="search-results"
                    class="overflow-y-auto p-2 flex flex-col gap-1 hidden"
                >
                </div>
                <div
                    id="search-empty"
                    class="py-14 text-center text-sm text-muted-foreground hidden"
                >
                    No results found.
                </div>
                <div
                    id="search-initial"
                    class="py-10 text-center text-sm text-muted-foreground"
                >
                    Type to start searching.
                </div>
            </div>
        </div>
        <script>
            import type { SearchItem } from "../types";

            let onThemeToggleClick: ((e: MouseEvent) => void) | null = null;
            let onSearchToggleClick: ((e: MouseEvent) => void) | null = null;
            let onSearchCloseClick: ((e: MouseEvent) => void) | null = null;
            let onSearchOverlayClick: ((e: MouseEvent) => void) | null = null;
            let onSearchKeydown: ((e: KeyboardEvent) => void) | null = null;
            let onSearchInputRaw: ((e: Event) => void) | null = null;
            let searchData: SearchItem[] | null = null;

            let onNavScroll: (() => void) | null = null;
            let lastScrollY = 0;

            document.addEventListener("astro:before-swap", () => {
                const themeToggle = document.getElementById("theme-toggle");
                if (onThemeToggleClick && themeToggle) {
                    themeToggle.removeEventListener(
                        "click",
                        onThemeToggleClick,
                    );
                    onThemeToggleClick = null;
                }

                const searchToggle = document.getElementById("search-toggle");
                const searchClose = document.getElementById("search-close");
                const searchOverlay = document.getElementById("search-overlay");
                const searchInput = document.getElementById("search-input");

                if (onSearchToggleClick && searchToggle)
                    searchToggle.removeEventListener(
                        "click",
                        onSearchToggleClick,
                    );
                if (onSearchCloseClick && searchClose)
                    searchClose.removeEventListener(
                        "click",
                        onSearchCloseClick,
                    );
                if (onSearchOverlayClick && searchOverlay)
                    searchOverlay.removeEventListener(
                        "click",
                        onSearchOverlayClick,
                    );
                if (onSearchInputRaw && searchInput)
                    searchInput.removeEventListener("input", onSearchInputRaw);
                if (onSearchKeydown)
                    document.removeEventListener("keydown", onSearchKeydown);

                onSearchToggleClick = null;
                onSearchCloseClick = null;
                onSearchOverlayClick = null;
                onSearchInputRaw = null;
                onSearchKeydown = null;

                if (onNavScroll) {
                    window.removeEventListener("scroll", onNavScroll);
                    onNavScroll = null;
                }
            });

            document.addEventListener("astro:page-load", () => {
                const langToggle = document.getElementById("lang-toggle");
                if (langToggle) {
                    langToggle.addEventListener("click", () => {
                        const order = ["zh", "en", "ja"] as const;
                        const raw = document.documentElement.dataset.lang;
                        const current =
                            (order as readonly string[]).includes(raw ?? "")
                                ? (raw as (typeof order)[number])
                                : "zh";
                        const next =
                            order[(order.indexOf(current) + 1) % order.length];
                        document.documentElement.dataset.lang = next;
                        try {
                            localStorage.setItem("site-lang", next);
                            // /cv and /about internal tabs only know zh/en —
                            // map ja → zh for those so they don't break.
                            const tabLang = next === "ja" ? "zh" : next;
                            localStorage.setItem("cv-lang", tabLang);
                            localStorage.setItem("about-lang", tabLang);
                            document
                                .querySelectorAll<HTMLButtonElement>(
                                    `[data-cv-tab="${tabLang}"], [data-about-tab="${tabLang}"]`,
                                )
                                .forEach((b) => b.click());
                        } catch {}
                    });
                }

                const themeToggle = document.getElementById("theme-toggle");
                if (!themeToggle) return;

                onThemeToggleClick = (event: MouseEvent) => {
                    const isDark =
                        document.documentElement.classList.contains("dark");

                    const toggleTheme = () => {
                        if (isDark) {
                            document.documentElement.classList.remove("dark");
                            localStorage.setItem("theme", "light");
                        } else {
                            document.documentElement.classList.add("dark");
                            localStorage.setItem("theme", "dark");
                        }
                    };

                    if (!document.startViewTransition) {
                        toggleTheme();
                        return;
                    }

                    const x = event.clientX;
                    const y = event.clientY;
                    // compute radius required to cover the entire viewport
                    // finds distance from click point to the farthest corner;
                    // hypot for calculating straight line distance
                    const endRadius = Math.hypot(
                        Math.max(x, innerWidth - x), // furthest horiz dist
                        Math.max(y, innerHeight - y), // furthest vert dist
                    );

                    document.documentElement.classList.add("theme-transition");

                    const transition = document.startViewTransition(() => {
                        toggleTheme();
                    });

                    transition.ready.then(() => {
                        const clipPath = [
                            `circle(0px at ${x}px ${y}px)`,
                            `circle(${endRadius}px at ${x}px ${y}px)`,
                        ];

                        document.documentElement.animate(
                            {
                                clipPath: clipPath,
                            },
                            {
                                duration: 500,
                                easing: "ease-in-out",
                                // targets the "new" snapshot layer created by the transition
                                pseudoElement: "::view-transition-new(root)",
                            },
                        );
                    });

                    // cleanup
                    transition.finished.finally(() => {
                        document.documentElement.classList.remove(
                            "theme-transition",
                        );
                    });
                };

                themeToggle.addEventListener("click", onThemeToggleClick);

                const searchToggle = document.getElementById("search-toggle");
                const searchClose = document.getElementById("search-close");
                const searchOverlay = document.getElementById("search-overlay");
                const searchModal = document.getElementById("search-modal");
                const searchInput = document.getElementById(
                    "search-input",
                ) as HTMLInputElement;
                const resultsContainer =
                    document.getElementById("search-results");
                const emptyState = document.getElementById("search-empty");
                const initialState = document.getElementById("search-initial");

                const openSearch = async () => {
                    if (!searchOverlay || !searchModal || !searchInput) return;
                    searchOverlay.removeAttribute("inert");
                    searchOverlay.setAttribute("aria-hidden", "false");
                    searchOverlay.classList.remove(
                        "opacity-0",
                        "pointer-events-none",
                    );
                    searchOverlay.classList.add("opacity-100");
                    searchModal.classList.remove("scale-95");
                    searchModal.classList.add("scale-100");
                    document.body.style.overflow = "hidden";
                    setTimeout(() => searchInput.focus(), 50);

                    if (!searchData) {
                        try {
                            const res = await fetch("/search.json");
                            searchData = await res.json();
                        } catch (e) {
                            console.error("Failed to load search index", e);
                        }
                    }
                };

                const closeSearch = () => {
                    if (!searchOverlay || !searchModal) return;
                    searchOverlay.setAttribute("inert", "");
                    searchOverlay.setAttribute("aria-hidden", "true");
                    searchOverlay.classList.add(
                        "opacity-0",
                        "pointer-events-none",
                    );
                    searchOverlay.classList.remove("opacity-100");
                    searchModal.classList.add("scale-95");
                    searchModal.classList.remove("scale-100");
                    document.body.style.overflow = "";
                };

                const renderResults = (query: string) => {
                    if (!resultsContainer || !emptyState || !initialState)
                        return;
                    if (!query.trim()) {
                        resultsContainer.classList.add("hidden");
                        emptyState.classList.add("hidden");
                        initialState.classList.remove("hidden");
                        return;
                    }
                    initialState.classList.add("hidden");
                    if (!searchData) return;

                    const q = query.toLowerCase();
                    const filtered = searchData.filter(
                        (post: SearchItem) =>
                            post.title.toLowerCase().includes(q) ||
                            post.frontmatter.toLowerCase().includes(q) ||
                            post.tags.some((tag: string) =>
                                tag.toLowerCase().includes(q),
                            ),
                    );

                    if (filtered.length === 0) {
                        resultsContainer.classList.add("hidden");
                        emptyState.classList.remove("hidden");
                    } else {
                        emptyState.classList.add("hidden");
                        resultsContainer.classList.remove("hidden");

                        resultsContainer.innerHTML = filtered
                            .map(
                                (post: SearchItem) => `
                            <a href="${post.link}" class="flex flex-col gap-1 p-3 rounded-lg hover:bg-secondary transition-colors group">
                                <div class="flex justify-between items-center bg-transparent">
                                    <span class="text-foreground font-medium group-hover:text-primary transition-colors line-clamp-1">${post.title}</span>
                                    <span class="text-xs text-muted-foreground whitespace-nowrap ml-4">${post.readTime} min · ${post.date}</span>
                                </div>
                                <span class="text-sm text-muted-foreground line-clamp-1">${post.frontmatter}</span>
                            </a>
                        `,
                            )
                            .join("");
                    }
                };

                onSearchToggleClick = () => openSearch();
                onSearchCloseClick = () => closeSearch();
                onSearchOverlayClick = (e: MouseEvent) => {
                    if (e.target === searchOverlay) closeSearch();
                };
                onSearchInputRaw = (e: Event) => {
                    const target = e.target as HTMLInputElement;
                    renderResults(target.value);
                };
                onSearchKeydown = (e: KeyboardEvent) => {
                    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
                        e.preventDefault();
                        openSearch();
                    } else if (e.key === "Escape") {
                        closeSearch();
                    }
                };

                if (searchToggle)
                    searchToggle.addEventListener("click", onSearchToggleClick);
                if (searchClose)
                    searchClose.addEventListener("click", onSearchCloseClick);
                if (searchOverlay)
                    searchOverlay.addEventListener(
                        "click",
                        onSearchOverlayClick,
                    );
                if (searchInput)
                    searchInput.addEventListener("input", onSearchInputRaw);
                document.addEventListener("keydown", onSearchKeydown);

                // scroll-aware navbar
                const nav = document.getElementById("main-nav");
                if (nav) {
                    lastScrollY = window.scrollY;

                    onNavScroll = () => {
                        const currentY = window.scrollY;

                        if (currentY > 100) {
                            nav.classList.add("nav-scrolled");
                        } else {
                            nav.classList.remove("nav-scrolled");
                        }

                        if (currentY > lastScrollY && currentY > 200) {
                            nav.classList.add("nav-hidden");
                        } else {
                            nav.classList.remove("nav-hidden");
                        }

                        lastScrollY = currentY;
                    };

                    window.addEventListener("scroll", onNavScroll);
                }
            });
        </script>
    </body>
</html>
