---
import { siteConfig } from "@/config";
import {
    ShieldCheck,
    FileText,
    AlertTriangle,
    BookMarked,
} from "@lucide/astro";
import { parseDate } from "@/utils/date";

interface Props {
    reviewer?: string;
    reviewerCredentials?: string;
    reviewedDate?: string;
    lastUpdated?: string;
    medicalCondition?: string;
    title?: string;
    titleEn?: string;
    date?: string;
    doi?: string;
    conceptDoi?: string;
}

const {
    reviewer = siteConfig.author.name,
    reviewerCredentials = siteConfig.author.credentials ?? "",
    reviewedDate,
    lastUpdated,
    medicalCondition,
    title,
    titleEn,
    date,
    doi,
    conceptDoi,
} = Astro.props;

const monthShortBibtex = [
    "jan",
    "feb",
    "mar",
    "apr",
    "may",
    "jun",
    "jul",
    "aug",
    "sep",
    "oct",
    "nov",
    "dec",
];
const monthFullEn = [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
];

// Citation prefers concept DOI (永遠指向最新版); falls back to version DOI.
const citationDoi = conceptDoi || doi;

function fmtDateZh(d: Date) {
    return `${d.getUTCFullYear()}年${d.getUTCMonth() + 1}月${d.getUTCDate()}日`;
}
function fmtDateEn(d: Date) {
    return `${monthFullEn[d.getUTCMonth()]} ${d.getUTCDate()}, ${d.getUTCFullYear()}`;
}

function buildAma() {
    if (!citationDoi || !title || !date) return null;
    const pubDate = parseDate(date);
    const updatedDate = lastUpdated ? parseDate(lastUpdated) : null;
    const updatedSameAsPub =
        updatedDate &&
        updatedDate.getTime() === pubDate.getTime();

    const zhParts = [
        `林協霆.`,
        `${title}.`,
        `${siteConfig.title}.`,
        `發表於 ${fmtDateZh(pubDate)}.`,
    ];
    if (updatedDate && !updatedSameAsPub) {
        zhParts.push(`更新於 ${fmtDateZh(updatedDate)}.`);
    }
    zhParts.push(`doi:${citationDoi}`);
    const zh = zhParts.join(" ");

    let en: string | null = null;
    if (titleEn && siteConfig.titleEn) {
        const enParts = [
            `Lin HT.`,
            `${titleEn}.`,
            `${siteConfig.titleEn}.`,
            `Published ${fmtDateEn(pubDate)}.`,
        ];
        if (updatedDate && !updatedSameAsPub) {
            enParts.push(`Updated ${fmtDateEn(updatedDate)}.`);
        }
        enParts.push(`doi:${citationDoi}`);
        en = enParts.join(" ");
    }
    return { zh, en };
}

function buildBibtex() {
    if (!citationDoi || !title || !date) return null;
    const d = parseDate(date);
    const year = d.getUTCFullYear();
    const month = monthShortBibtex[d.getUTCMonth()];
    const today = new Date().toISOString().slice(0, 10);
    const slugBase = (titleEn || title)
        .replace(/[^A-Za-z0-9]/g, " ")
        .trim()
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((w) => w[0].toUpperCase() + w.slice(1).toLowerCase())
        .join("");
    const citeKey = `Lin${year}${slugBase || "Post"}`;
    return [
        `@article{${citeKey},`,
        `  author   = {Lin, Hsieh-Ting},`,
        `  title    = {${titleEn || title}},`,
        titleEn && title ? `  titleaddon = {${title}},` : null,
        `  journal  = {${siteConfig.titleEn || siteConfig.title}},`,
        `  year     = {${year}},`,
        `  month    = ${month},`,
        `  doi      = {${citationDoi}},`,
        `  url      = {https://doi.org/${citationDoi}},`,
        `  urldate  = {${today}},`,
        `  language = {zh-TW}`,
        `}`,
    ]
        .filter(Boolean)
        .join("\n");
}

const ama = buildAma();
const bibtex = buildBibtex();

const fmt = (iso?: string) => {
    if (!iso) return null;
    try {
        const d = parseDate(iso);
        return d.toLocaleDateString("zh-TW", {
            timeZone: "UTC",
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
        });
    } catch {
        return iso;
    }
};

const reviewedFormatted = fmt(reviewedDate);
const lastUpdatedFormatted = fmt(lastUpdated);
---

<aside
    class="not-prose mt-12 mb-6 border border-border rounded-xl bg-secondary/30 p-5 text-sm leading-relaxed space-y-4"
    aria-label="醫療審稿與免責聲明"
>
    <header class="flex items-start gap-3">
        <ShieldCheck class="text-primary mt-0.5 shrink-0" size={18} />
        <div class="flex-1">
            <div class="text-xs uppercase tracking-widest text-muted-foreground">
                醫師審稿 · Medical Review
            </div>
            <div class="mt-1 font-medium text-foreground">
                {reviewer}{reviewerCredentials && (
                    <span class="text-muted-foreground font-normal">
                        ｜{reviewerCredentials}
                    </span>
                )}
            </div>
            <div class="text-xs text-muted-foreground mt-1 flex flex-wrap gap-x-3 gap-y-1">
                {reviewedFormatted && (
                    <span>審稿日期：{reviewedFormatted}</span>
                )}
                {lastUpdatedFormatted && (
                    <span>最後更新：{lastUpdatedFormatted}</span>
                )}
                {medicalCondition && (
                    <span>主題：{medicalCondition}</span>
                )}
            </div>
        </div>
    </header>

    <section class="flex items-start gap-3">
        <AlertTriangle
            class="text-amber-500 mt-0.5 shrink-0"
            size={18}
        />
        <div>
            <div class="text-xs uppercase tracking-widest text-muted-foreground">
                風險揭露 · Risk Disclosure
            </div>
            <p class="mt-1 text-foreground/90">
                文中所討論之治療多為臨床試驗或國外仿單外使用 (off-label)，可能尚未取得台灣
                TFDA 核准。實際適應症、禁忌症、副作用、劑量與療程，因個別腫瘤分期、體能狀態
                (PS)、共病與基因型而異。
            </p>
        </div>
    </section>

    <section class="flex items-start gap-3">
        <FileText class="text-muted-foreground mt-0.5 shrink-0" size={18} />
        <div>
            <div class="text-xs uppercase tracking-widest text-muted-foreground">
                免責聲明 · Disclaimer
            </div>
            <p class="mt-1 text-muted-foreground">
                本文整理自公開發表之臨床試驗結果與 NCCN／ASCO／ESMO 治療指引，僅供醫學新知與
                病人衛生教育參考，不構成個別醫療建議，亦不取代主治醫師之診療判斷。實際治療
                決策請與您的主治團隊面對面討論。本網站不從事醫療業務招徠。
            </p>
            {siteConfig.socials.line && (
                <p class="mt-2 text-xs text-muted-foreground">
                    文章勘誤、衛教提問、學術討論可透過{" "}
                    <a
                        href={siteConfig.socials.line}
                        target="_blank"
                        rel="noopener"
                        class="text-foreground underline-offset-4 hover:underline hover:text-primary"
                    >
                        LINE 官方帳號 @927pjtfa
                    </a>
                    {" "}回饋。<strong>本管道不提供個別診療建議</strong>。
                </p>
            )}
        </div>
    </section>

    {citationDoi && (
        <section class="flex items-start gap-3 border-t border-border pt-4">
            <BookMarked
                class="text-primary mt-0.5 shrink-0"
                size={18}
            />
            <div class="flex-1 min-w-0 space-y-3">
                <div>
                    <div class="text-xs uppercase tracking-widest text-muted-foreground">
                        引用本文 · Cite this
                    </div>
                    <p class="mt-1 break-all">
                        DOI:{" "}
                        <a
                            href={`https://doi.org/${citationDoi}`}
                            target="_blank"
                            rel="noopener"
                            class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                        >
                            {citationDoi}
                        </a>
                        {conceptDoi && doi && conceptDoi !== doi && (
                            <span class="text-muted-foreground">
                                {" "}
                                · 此版本{" "}
                                <a
                                    href={`https://doi.org/${doi}`}
                                    target="_blank"
                                    rel="noopener"
                                    class="hover:text-primary underline-offset-4 hover:underline"
                                >
                                    {doi}
                                </a>
                            </span>
                        )}
                    </p>
                </div>

                {ama && (
                    <div class="space-y-2">
                        <div>
                            <div class="text-xs text-muted-foreground mb-1">
                                AMA 格式 · 中文
                            </div>
                            <pre class="p-3 bg-secondary/60 rounded text-xs whitespace-pre-wrap break-words leading-relaxed">{ama.zh}</pre>
                        </div>
                        {ama.en && (
                            <div>
                                <div class="text-xs text-muted-foreground mb-1">
                                    AMA style · English
                                </div>
                                <pre class="p-3 bg-secondary/60 rounded text-xs whitespace-pre-wrap break-words leading-relaxed">{ama.en}</pre>
                            </div>
                        )}
                    </div>
                )}

                {bibtex && (
                    <details class="text-xs text-muted-foreground">
                        <summary class="cursor-pointer hover:text-foreground select-none">
                            BibTeX
                        </summary>
                        <pre class="mt-2 p-3 bg-secondary/60 rounded text-xs whitespace-pre-wrap break-words">{bibtex}</pre>
                    </details>
                )}
            </div>
        </section>
    )}
</aside>
