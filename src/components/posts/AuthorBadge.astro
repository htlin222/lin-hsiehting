---
import { Image } from "astro:assets";
import avatar from "@/assets/images/avatar.jpg";
import { siteConfig } from "@/config";

interface Props {
    compact?: boolean;
}

const { compact = false } = Astro.props;
const tagline = [
    siteConfig.author.specialty,
    siteConfig.author.affiliation,
]
    .filter(Boolean)
    .join("｜");
const avatarSizePx = compact ? 24 : 28;
---

<a
    href="/about/"
    class={`not-prose group inline-flex items-center gap-3 rounded-full border border-border bg-secondary/40 hover:bg-secondary transition-colors ${compact ? "px-2 py-1" : "px-3 py-1.5"} max-w-full`}
    aria-label={`關於作者 ${siteConfig.author.name}`}
>
    <Image
        src={avatar}
        alt={siteConfig.author.name}
        width={avatarSizePx * 2}
        height={avatarSizePx * 2}
        loading="lazy"
        class="shrink-0 rounded-full object-cover border border-border"
        style={`width: ${avatarSizePx}px; height: ${avatarSizePx}px;`}
    />
    <span class="flex flex-col leading-tight min-w-0">
        <span class="text-sm font-medium text-foreground truncate">
            {siteConfig.author.name}
            {siteConfig.author.credentials && (
                <span class="text-muted-foreground font-normal">
                    ｜{siteConfig.author.credentials}
                </span>
            )}
        </span>
        {tagline && !compact && (
            <span
                class="text-xs text-muted-foreground truncate group-hover:text-foreground/80 transition-colors"
            >
                {tagline}
            </span>
        )}
    </span>
</a>
