---
import { HelpCircle } from "@lucide/astro";

interface FaqItem {
    q: string;
    a: string;
}

interface Props {
    items?: FaqItem[];
}

const { items = [] } = Astro.props;
const hasItems = items.length > 0;
---

{
    hasItems && (
        <section
            class="faq not-prose mt-12 border border-border rounded-xl bg-secondary/30 px-5 py-5"
            aria-label="常見問題"
        >
            <header class="flex items-center gap-2 mb-4">
                <HelpCircle class="text-primary shrink-0" size={18} />
                <h2 class="text-base font-semibold text-foreground m-0">
                    常見問題
                </h2>
            </header>
            <div class="divide-y divide-border">
                {items.map((item, idx) => (
                    <details
                        class="group py-3 first:pt-0 last:pb-0"
                        open={idx === 0}
                    >
                        <summary class="flex cursor-pointer items-start justify-between gap-3 list-none [&::-webkit-details-marker]:hidden">
                            <span class="font-medium text-foreground leading-snug">
                                {item.q}
                            </span>
                            <span
                                class="text-muted-foreground transition-transform group-open:rotate-180 shrink-0 mt-1"
                                aria-hidden="true"
                            >
                                ▾
                            </span>
                        </summary>
                        <div class="mt-2 text-foreground/85 leading-relaxed">
                            {item.a}
                        </div>
                    </details>
                ))}
            </div>
        </section>
    )
}
