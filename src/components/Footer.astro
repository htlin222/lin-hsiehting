---
import { siteConfig } from "@/config";
import { Github, Twitter, Linkedin, Mail } from "@lucide/astro";
import LineAddButton from "@/components/LineAddButton.astro";
---

<footer class="border-t border-border mt-20 py-10 px-10 lg:px-20">
    <div
        class="flex flex-col md:flex-row justify-between items-center gap-6"
    >
        <div class="flex flex-col items-center md:items-start gap-2">
            <span class="text-sm text-muted-foreground">
                &copy; {new Date().getFullYear()}
                <span data-lang-only="zh">{siteConfig.title}</span>
                <span data-lang-only="en">
                    {siteConfig.titleEn ?? siteConfig.title}
                </span>
                <span data-lang-only="ja">
                    {siteConfig.titleJa ?? siteConfig.titleEn ?? siteConfig.title}
                </span>
            </span>
            <span class="text-xs text-muted-foreground">
                Built with <a
                    href="https://astro.build"
                    target="_blank"
                    rel="noreferrer"
                    class="hover:text-primary transition-colors">Astro</a
                >
            </span>
        </div>

        <div class="flex items-center gap-4">
            {
                siteConfig.socials.github && (
                    <a
                        href={siteConfig.socials.github}
                        target="_blank"
                        rel="noreferrer"
                        aria-label="GitHub"
                        class="text-muted-foreground hover:text-primary transition-colors"
                    >
                        <Github size={18} />
                    </a>
                )
            }
            {
                siteConfig.socials.twitter && (
                    <a
                        href={siteConfig.socials.twitter}
                        target="_blank"
                        rel="noreferrer"
                        aria-label="Twitter"
                        class="text-muted-foreground hover:text-primary transition-colors"
                    >
                        <Twitter size={18} />
                    </a>
                )
            }
            {
                siteConfig.socials.linkedin && (
                    <a
                        href={siteConfig.socials.linkedin}
                        target="_blank"
                        rel="noreferrer"
                        aria-label="LinkedIn"
                        class="text-muted-foreground hover:text-primary transition-colors"
                    >
                        <Linkedin size={18} />
                    </a>
                )
            }
            <LineAddButton class="opacity-80 hover:opacity-100 transition-opacity" />

            {
                siteConfig.socials.email && (
                    <a
                        href={`mailto:${siteConfig.socials.email}`}
                        aria-label={`Email ${siteConfig.socials.email}（勘誤／衛教提問／學術合作，不提供個別診療建議）`}
                        title={`${siteConfig.socials.email}（勘誤／衛教提問／學術合作，不提供個別診療建議）`}
                        class="text-muted-foreground hover:text-primary transition-colors"
                    >
                        <Mail size={18} />
                    </a>
                )
            }
            <a
                href="/feed.xml"
                class="text-sm text-muted-foreground hover:text-primary transition-colors"
            >
                <span data-lang-only="zh">訂閱 RSS</span>
                <span data-lang-only="en">Subscribe to RSS</span>
                <span data-lang-only="ja">RSS を購読</span>
            </a>
        </div>
    </div>
</footer>
