---
import { getCollection } from "astro:content";
import Badge from "./ui/Badge.astro";
import { siteConfig } from "@/config";
import { calcReadTime } from "@/utils/reading-time";

interface Props {
    page?: number;
}

const { page = 1 } = Astro.props;

const entries = await getCollection("post");
const allPosts = entries
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
        id: entry.id,
        slug: entry.id,
        readTime: calcReadTime(entry.body!),
        ...entry.data,
    }))
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const totalPages = Math.ceil(allPosts.length / siteConfig.postsPerPage);
const posts = allPosts.slice(
    (page - 1) * siteConfig.postsPerPage,
    page * siteConfig.postsPerPage,
);

type MappedPost = (typeof posts)[number];

const monthName = (n: number) =>
    new Date(2000, n - 1).toLocaleString("en", { month: "short" });

const dateRange = (postsInMonth: MappedPost[]) => {
    const days = postsInMonth.map((p) => Number(p.date.split("/")[1]));
    const min = Math.min(...days);
    const max = Math.max(...days);
    return min === max ? String(min) : `${min} - ${max}`;
};

const grouped = posts.reduce(
    (acc, post) => {
        const [m, , y] = post.date.split("/");
        const month = monthName(Number(m));
        if (!acc[y]) acc[y] = {};
        if (!acc[y][month]) acc[y][month] = [];
        acc[y][month].push(post);
        return acc;
    },
    {} as Record<string, Record<string, MappedPost[]>>,
);

const pageUrl = (p: number) => (p === 1 ? "/" : `/page/${p}/`);

// Windowed pagination: always show first + last + current ± 1, with "…"
// fillers for the gaps. Keeps the row to ≤7 items so it fits on a 320px
// viewport instead of overflowing the page max-width on mobile.
function buildPageItems(
    current: number,
    total: number,
): (number | "ellipsis")[] {
    if (total <= 7) {
        return Array.from({ length: total }, (_, i) => i + 1);
    }
    const items: (number | "ellipsis")[] = [];
    const start = Math.max(2, current - 1);
    const end = Math.min(total - 1, current + 1);
    items.push(1);
    if (start > 2) items.push("ellipsis");
    for (let p = start; p <= end; p++) items.push(p);
    if (end < total - 1) items.push("ellipsis");
    items.push(total);
    return items;
}
const pageItems = buildPageItems(page, totalPages);
---

<main class="page">
    <span class="uppercase text-primary font-medium tracking-widest">
        <span data-lang-only="zh">臨床筆記</span>
        <span data-lang-only="en">Clinical Notes</span>
        <span data-lang-only="ja">臨床ノート</span>
    </span>

    <h1 class="text-4xl mt-10">
        <span data-lang-only="zh">近期書寫</span>
        <span data-lang-only="en">Recent Writing</span>
        <span data-lang-only="ja">最近の執筆</span>
    </h1>
    <p class="text-lg max-w-prose text-muted-foreground">
        <span data-lang-only="zh">
            腫瘤治療新知、衛教整理，以及病房裡指引未盡之處的臨床思考。
        </span>
        <span data-lang-only="en">
            Notes on oncology updates, patient education, and the clinical
            reasoning beyond what guidelines cover.
        </span>
        <span data-lang-only="ja">
            腫瘍診療の最新知見、患者教育、ガイドラインの届かない臨床判断についての覚書。
        </span>
    </p>

    <section class="mt-20 my-5">
        {
            Object.keys(grouped)
                .sort((a, b) => Number(b) - Number(a))
                .map((year) => (
                    <section>
                        <h2 class="text-2xl">{year}</h2>
                        {Object.entries(grouped[year]).map(
                            ([month, monthPosts]) => (
                                <section>
                                    <h3 class="text-sm text-muted-foreground uppercase font-medium tracking-widest">
                                        {month} {dateRange(monthPosts)}
                                    </h3>
                                    <hr class="mt-2" />
                                    <section class="flex flex-col gap-3 my-5">
                                        {monthPosts.map((post) => (
                                            <section class="flex flex-col gap-2 group hover:bg-muted px-3 py-8 rounded-md transition-all duration-300 relative overflow-hidden">
                                                <div class="flex flex-col md:flex-row gap-2 md:justify-between md:items-start">
                                                    <a
                                                        href={`/posts/${post.slug}/`}
                                                    >
                                                        <h2 class="text-2xl group-hover:text-primary leading-tight">
                                                            {post.title}
                                                        </h2>
                                                    </a>
                                                    <span class="text-muted-foreground text-xs shrink-0 whitespace-nowrap md:mt-1 md:text-right text-left mt-1">
                                                        {post.readTime} min read
                                                    </span>
                                                </div>
                                                <p class="text-muted-foreground">
                                                    {post.frontmatter}
                                                </p>
                                                <section class="flex gap-2 flex-wrap">
                                                    {post.tags.map((tag) => (
                                                        <Badge
                                                            content={tag}
                                                            href={`/tags/${tag}/`}
                                                        />
                                                    ))}
                                                </section>
                                            </section>
                                        ))}
                                    </section>
                                </section>
                            ),
                        )}
                    </section>
                ))
        }
    </section>

    {
        totalPages > 1 && (
            <nav
                class="flex items-center justify-center gap-1 sm:gap-2 mt-16 mb-10 flex-wrap"
                aria-label="Pagination"
            >
                {page > 1 && (
                    <a
                        href={pageUrl(page - 1)}
                        class="text-sm text-muted-foreground hover:text-primary transition-colors px-2 py-1.5 sm:px-3 sm:py-2"
                        aria-label="Previous page"
                    >
                        ←
                    </a>
                )}
                {pageItems.map((item) =>
                    item === "ellipsis" ? (
                        <span
                            class="text-sm text-muted-foreground px-1 sm:px-2 py-1.5 sm:py-2 select-none"
                            aria-hidden="true"
                        >
                            …
                        </span>
                    ) : (
                        <a
                            href={pageUrl(item)}
                            class:list={[
                                "text-sm px-2 py-1.5 sm:px-3 sm:py-2 rounded-md transition-colors",
                                item === page
                                    ? "bg-primary text-primary-foreground font-medium"
                                    : "text-muted-foreground hover:text-primary hover:bg-muted",
                            ]}
                            aria-current={item === page ? "page" : undefined}
                        >
                            {item}
                        </a>
                    ),
                )}
                {page < totalPages && (
                    <a
                        href={pageUrl(page + 1)}
                        class="text-sm text-muted-foreground hover:text-primary transition-colors px-2 py-1.5 sm:px-3 sm:py-2"
                        aria-label="Next page"
                    >
                        →
                    </a>
                )}
            </nav>
        )
    }
</main>
