<script>
    type Lang = "en" | "zh";

    const tabs = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-about-tab]"),
    );
    const panels = Array.from(
        document.querySelectorAll<HTMLElement>("[data-about-panel]"),
    );
    const bioZh = document.querySelector<HTMLElement>("[data-bio-zh]");
    const bioEn = document.querySelector<HTMLElement>("[data-bio-en]");

    function activate(name: Lang) {
        for (const t of tabs) {
            const active = t.dataset.aboutTab === name;
            t.setAttribute("aria-selected", String(active));
            t.tabIndex = active ? 0 : -1;
        }
        for (const p of panels) {
            p.hidden = p.dataset.aboutPanel !== name;
        }
        if (bioZh && bioEn) {
            bioZh.hidden = name !== "zh";
            bioEn.hidden = name !== "en";
        }
        try {
            localStorage.setItem("about-lang", name);
        } catch {}
        if (location.hash !== `#${name}`) {
            history.replaceState(null, "", `#${name}`);
        }
    }

    function initialLang(): Lang {
        const hash = location.hash.replace("#", "");
        if (hash === "en" || hash === "about-en") return "en";
        if (hash === "zh" || hash === "about-zh") return "zh";
        try {
            const saved = localStorage.getItem("about-lang");
            if (saved === "en") return "en";
            if (saved === "zh") return "zh";
        } catch {}
        // Default to zh-TW since the site is zh-TW first.
        return "zh";
    }

    for (const t of tabs) {
        t.addEventListener("click", () => {
            const name = t.dataset.aboutTab as Lang | undefined;
            if (name) activate(name);
        });
        t.addEventListener("keydown", (e) => {
            if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
            e.preventDefault();
            const order: Lang[] = ["zh", "en"];
            const current = order.indexOf(t.dataset.aboutTab as Lang);
            const next =
                order[
                    (current + (e.key === "ArrowRight" ? 1 : -1) + order.length) %
                        order.length
                ];
            const target = document.querySelector<HTMLButtonElement>(
                `[data-about-tab="${next}"]`,
            );
            target?.focus();
            activate(next);
        });
    }

    activate(initialLang());

    window.addEventListener("hashchange", () => {
        const hash = location.hash.replace("#", "");
        if (hash === "en" || hash === "about-en") activate("en");
        else if (hash === "zh" || hash === "about-zh") activate("zh");
    });
</script>

