---
import {
    BookOpen,
    Briefcase,
    GraduationCap,
    IdCard,
    ShieldCheck,
    ExternalLink,
    Github,
    Mail,
    Wrench,
} from "@lucide/astro";

interface SkillGroup {
    title: string;
    titleEn: string;
    body: string;
    repos: string[];
}

// Skills inventory grounded in the public repos at github.com/htlin222.
// Each item below is supported by one or more concrete repos in /portfolio so
// nothing here is generic AI-flavored padding — drop a repo, drop the claim.
const skills: SkillGroup[] = [
    {
        title: "臨床研究方法學",
        titleEn: "Clinical research methodology",
        body: "Meta-analysis、network meta-analysis、survival analysis（含 competing risks、immortal time、left truncation）、Bayesian target trial emulation、causal inference（DAG / propensity / TMLE）、real-world evidence（MMRM / CMH）。R + Quarto IMRAD pipeline，已用於 BTK 抑制劑、PARP 抑制劑、ICI 時序、咖啡因等多個 RCT 統合分析。",
        repos: [
            "meta-pipe",
            "robust-lit-review",
            "survival-pipe",
            "sepsis-dynamic-treatment-tt-emulation",
            "research-in-cancer-center",
            "hrd-parp-inhibitors",
            "btk-wm",
            "early-immuno-timing-nma",
            "ici-breast-cancer",
            "causal-tut",
            "TMLE-explain",
            "roche-vabysmo-rwe-workshop",
            "prisma-automation",
        ],
    },
    {
        title: "精準腫瘤學與多體學分析",
        titleEn: "Precision oncology & multi-omics",
        body: "NGS tertiary analysis（BAM → ESMO 2024 clinical report，含 OncoKB、AMP/ASCO/CAP、ESCAT 分級）、TCGA / METABRIC / SCAN-B 再分析、單細胞 RNA-seq 與 bulk transcriptomic 拓樸風險分層、機器學習於 AML 多體學藥物反應與乳癌放療反應預測。",
        repos: [
            "ngs-tertiary-analysis-skills",
            "ngs-tertiary-analysis-paper",
            "tcga-brca-reanalysis",
            "topological-stratification-aml",
            "sctda-cancer-plasticity",
            "AML-MultiOmics-Predictor",
            "breast_cancer_radiogenomics",
            "flt3-signature-ml",
            "FoundationOne-to-Oncoprinter",
        ],
    },
    {
        title: "臨床決策 AI 與 MCP 工具開發",
        titleEn: "Clinical AI tooling & MCP servers",
        body: "建構與維護多個 MCP / Vercel Skills 套件：OpenEvidence 雙向整合 + Crossref 驗證、NCCN PDF 轉結構化 skill、EBMT 8e、Micromedex 風格 DDI、護理實證升等教練、Anki 整合。多套件以「parallel Haiku、anti-hallucination 引用驗證」為設計核心。發表 NEJM AI Perspective 級論文討論 LLM 診斷失敗模式。",
        repos: [
            "openevidence-mcp",
            "openevidence-skill",
            "audit-oe-skill",
            "nccn-skill",
            "ebmt-handbook-skill",
            "drug-drug-skill",
            "cps-skills",
            "research-guardian-skill",
            "zh-ebn-report-skill",
            "llm-diagnosis-perspective",
            "llm-in-med",
            "yanki-mcp-server",
        ],
    },
    {
        title: "學術寫作與可重現研究",
        titleEn: "Academic writing & reproducible research",
        body: "Quarto / Pandoc / Typst / LaTeX 全流程；AMA、APA CSL；CrossRef DOI 驗證；BibTeX 多格式輸出；Docker 化 R 環境；醫療專用 cookiecutter 範本；已準備中的手稿涵蓋 NEJM AI、PLOS Medicine、American Psychologist、JCO 等期刊投稿風格。",
        repos: [
            "academic-manuscript-workflow",
            "cookiecutter-quarto-research",
            "bestseller",
            "rocker",
            "meta-pipe-manuscript",
            "to-comfort-always",
            "flowdoc",
            "quarto-doc",
            "quarto_theme",
        ],
    },
    {
        title: "教學與訓練資源",
        titleEn: "Teaching & training resources",
        body: "ABIM 血液內科自製 72 主題 + 216 題、台灣 N1–N4 護理實證升等教練、臨床統計與因果推論視覺化（含 TMLE / DAG / propensity score 動畫）、Network meta-analysis with R 中文教學；ASH 2026 Asia-Pacific 與 ASH B-cell lymphoma 系列 Reveal.js 簡報。",
        repos: [
            "hematology-board-review",
            "pocket-hematology",
            "zh-ebn-report-skill",
            "calculus-for-medstats",
            "r-nma",
            "r-with-ai-eng",
            "learn-r-with-ai",
            "HOASH-2026-Asia",
            "ASH-MCL",
            "qbank2anki",
            "anki_batch",
        ],
    },
    {
        title: "醫院流程自動化",
        titleEn: "Hospital workflow automation",
        body: "KFSYSCC IRB 文件批次生成（43 表單、11 類別、一鍵）、TMA 月度繼續教育、教育部學術倫理課程、醫學會行事曆 → Google Calendar、北榮泌尿部排班系統、e-portfolio 教學評核、新生兒奶量計算、病理面積六角格量測。",
        repos: [
            "irb-in-hurry",
            "irb-time",
            "tma-edu-exam",
            "auto-tms",
            "society-calendar",
            "vghtpe-uro",
            "education-portfolio",
            "duty_scheduler",
            "milkCalc",
            "areacalc",
            "hemonc-daily-case",
        ],
    },
];

const techStack = [
    "R / Quarto",
    "Python",
    "TypeScript / Astro",
    "LaTeX / Typst / Pandoc",
    "Claude Code / Codex / MCP",
    "Docker / Cloudflare Workers",
    "GitHub Actions",
];

import { Image } from "astro:assets";
import avatar from "@/assets/images/avatar.jpg";
import { siteConfig } from "@/config";

const certifications = [
    "台灣內科醫學會 內科專科醫師",
    "台灣癌症醫學會 腫瘤內科專科醫師",
];

const principles = [
    {
        title: "依國際指引",
        body: "臨床主題以 NCCN、ASCO、ESMO 最新版指引、以及 PubMed 索引論文為主要來源，並比對台灣腫瘤醫學會、國健署資料。",
    },
    {
        title: "署名審稿、標註日期",
        body: "每篇醫療相關文章皆由本人署名審稿，文末顯示審稿日期與最後更新日期；新版指引釋出時依年度重審。",
    },
    {
        title: "符合醫療法 §87",
        body: "本站屬醫療法第 87 條第 2 項所定之醫學新知與病人衛生教育，不從事醫療業務招徠，避免「保證、根治、最有效、永不復發」等違反法規之用語。",
    },
    {
        title: "個案資料去識別化",
        body: "若引用個案經驗，必經充分去識別化處理，並僅以教學、衛教為目的；不公開可辨識病人身分之內容。",
    },
];

const profileLinks = [
    {
        label: "ORCID 0009-0002-3974-4528",
        href: siteConfig.author.orcid,
    },
    {
        label: "Google Scholar",
        href: siteConfig.author.scholar,
    },
    {
        label: "GitHub @htlin222",
        href: siteConfig.socials.github,
    },
].filter((p) => p.href);
---

<main class="page flex flex-col space-y-12 max-w-3xl mx-auto pb-20">
    <section class="pt-6 flex flex-col sm:flex-row gap-6 items-start">
        <Image
            src={avatar}
            alt={`${siteConfig.author.name} ${siteConfig.author.credentials ?? ""}`.trim()}
            width={320}
            height={320}
            loading="eager"
            class="shrink-0 rounded-full object-cover border border-border"
            style="width: 7rem; height: 7rem;"
        />
        <div class="flex-1 min-w-0">
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">
                林協霆 M.D.
            </h1>
            <p class="text-muted-foreground mt-1">
                Hsieh-Ting Lin · {siteConfig.author.specialty}
            </p>
            <p class="mt-4 text-sm leading-relaxed">
                {siteConfig.author.bio}
            </p>
            <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs sm:text-sm">
                {profileLinks.map((p) => (
                    <li>
                        <a
                            href={p.href}
                            target="_blank"
                            rel="me noopener"
                            class="inline-flex items-center gap-1 hover:text-primary transition-colors underline-offset-4 hover:underline"
                        >
                            <ExternalLink size={13} />
                            {p.label}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="space-y-3 text-sm leading-relaxed">
        <h2 class="text-xl font-semibold">關於本站</h2>
        <p>
            本站為腫瘤內科臨床筆記、衛教整理與閱讀記錄，主要服務兩種讀者：
        </p>
        <ul class="list-disc list-outside ml-5 space-y-1.5">
            <li>
                <strong>病友與家屬</strong>：以「病人真正會問」的問題切入，整理治療選項、副作用、與決策時可帶去診間的問題清單。
            </li>
            <li>
                <strong>同業與住院醫師</strong>：整理新藥臨床試驗、跨指引差異、以及臨床上未必能立刻找到實證的灰色地帶。
            </li>
        </ul>
        <p>
            本站不取代主治醫師之診療判斷，亦不從事醫療業務招徠。實際治療決策請與您的醫療團隊面對面討論。
        </p>
    </section>

    <section class="space-y-4">
        <h2 class="flex items-center gap-2 text-xl font-semibold">
            <ShieldCheck size={20} class="text-primary" /> 編輯方針 · Editorial
            Policy
        </h2>
        <ol
            class="list-decimal list-outside ml-5 space-y-3 text-sm leading-relaxed marker:text-muted-foreground"
        >
            {principles.map((p) => (
                <li>
                    <strong class="text-foreground">{p.title}</strong>
                    <span class="text-muted-foreground"> — {p.body}</span>
                </li>
            ))}
        </ol>
    </section>

    <section class="space-y-4">
        <h2 class="flex items-center gap-2 text-xl font-semibold">
            <Wrench size={20} class="text-primary" /> 技能與作品 · Skills
        </h2>
        <p class="text-sm text-muted-foreground leading-relaxed">
            以下技能項目皆對應公開的
            <a
                href="/portfolio"
                class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                >GitHub repos</a
            >；點擊任一專案標籤可直接跳到該 repo 檢視程式碼、文件與最近更新。
        </p>

        <div class="flex flex-wrap gap-1.5 pb-2">
            {techStack.map((t) => (
                <span class="inline-flex items-center px-2 py-0.5 rounded border border-border bg-muted text-xs text-muted-foreground">
                    {t}
                </span>
            ))}
        </div>

        <ol
            class="list-decimal list-outside ml-5 space-y-5 text-sm leading-relaxed marker:text-muted-foreground"
        >
            {skills.map((s) => (
                <li>
                    <div>
                        <strong class="text-foreground">{s.title}</strong>
                        <span class="text-muted-foreground"> · {s.titleEn}</span>
                    </div>
                    <p class="mt-1 text-muted-foreground">{s.body}</p>
                    <div class="mt-2 flex flex-wrap gap-1.5">
                        {s.repos.map((r) => (
                            <a
                                href={`https://github.com/htlin222/${r}`}
                                target="_blank"
                                rel="noopener"
                                class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded border border-border bg-card text-xs text-foreground/85 hover:text-primary hover:border-primary transition-colors"
                            >
                                {r}
                                <ExternalLink size={9} class="opacity-60" />
                            </a>
                        ))}
                    </div>
                </li>
            ))}
        </ol>

        <p class="text-xs text-muted-foreground leading-relaxed pt-2">
            完整 210 個公開 repos（醫療 79 + IT 131）依時間排序見
            <a
                href="/portfolio"
                class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                >/portfolio</a
            >。學術發表以
            <a
                href={siteConfig.author.scholar}
                target="_blank"
                rel="me noopener"
                class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                >Google Scholar</a
            >
            為準；歷年口頭報告與證照見
            <a
                href="/cv"
                class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                >CV</a
            >。
        </p>
    </section>

    <section class="space-y-3">
        <h2 class="flex items-center gap-2 text-xl font-semibold">
            <Briefcase size={20} class="text-muted-foreground" /> 現職
        </h2>
        <ul class="text-sm leading-relaxed">
            <li class="grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-4">
                <span class="text-muted-foreground tabular-nums pt-0.5"
                    >2023.08 –</span
                >
                <div>
                    <p class="font-medium">血液腫瘤科專研醫師（Fellow）</p>
                    <p class="text-muted-foreground">
                        {siteConfig.author.affiliationUrl ? (
                            <a
                                href={siteConfig.author.affiliationUrl}
                                target="_blank"
                                rel="noopener"
                                class="hover:text-primary transition-colors underline-offset-4 hover:underline"
                            >
                                {siteConfig.author.affiliation}
                            </a>
                        ) : (
                            siteConfig.author.affiliation
                        )}
                    </p>
                </div>
            </li>
        </ul>
    </section>

    <section class="space-y-3">
        <h2 class="flex items-center gap-2 text-xl font-semibold">
            <GraduationCap size={20} class="text-muted-foreground" /> 學歷
        </h2>
        <ul class="text-sm leading-relaxed">
            <li class="grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-4">
                <span class="text-muted-foreground tabular-nums pt-0.5"
                    >2013 – 2019</span
                >
                <div>
                    <p class="font-medium">
                        醫學系（Doctor of Medicine）
                    </p>
                    <p class="text-muted-foreground">
                        國立成功大學 National Cheng Kung University
                    </p>
                </div>
            </li>
        </ul>
    </section>

    <section class="space-y-3">
        <h2 class="flex items-center gap-2 text-xl font-semibold">
            <IdCard size={20} class="text-muted-foreground" /> 專科證照
        </h2>
        <ul
            class="list-disc list-outside ml-5 space-y-1.5 text-sm marker:text-muted-foreground"
        >
            {certifications.map((c) => <li>{c}</li>)}
        </ul>
    </section>

    <section class="space-y-3">
        <h2 class="flex items-center gap-2 text-xl font-semibold">
            <BookOpen size={20} class="text-muted-foreground" /> 完整學經歷與發表
        </h2>
        <p class="text-sm text-muted-foreground leading-relaxed">
            完整現職、經歷、發表、口頭報告與專科證照清單，請見
            <a
                href="/cv"
                class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                >CV 頁</a
            >；學術發表與引用以
            <a
                href={siteConfig.author.scholar}
                target="_blank"
                rel="me noopener"
                class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                >Google Scholar</a
            >
            為準。
        </p>
    </section>

    <section class="space-y-3 pt-2 border-t border-border">
        <h2 class="flex items-center gap-2 text-xl font-semibold pt-6">
            <Github size={20} class="text-muted-foreground" /> 聯絡與更新
        </h2>
        <p class="text-sm text-muted-foreground leading-relaxed">
            本站源碼與版本紀錄公開於
            <a
                href={siteConfig.socials.github}
                target="_blank"
                rel="me noopener"
                class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                >GitHub</a
            >；內容修訂以 git commit 留下時間戳。學術合作、糾錯、衛教合作請開
            issue 或透過
            <a
                href={siteConfig.author.orcid}
                target="_blank"
                rel="me noopener"
                class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                >ORCID</a
            >
            聯絡。
        </p>
        {siteConfig.socials.email && (
            <p class="text-sm text-muted-foreground leading-relaxed flex items-center gap-2">
                <Mail size={16} class="text-muted-foreground shrink-0" />
                <span>
                    <strong class="text-foreground">Email</strong>：
                    <a
                        href={`mailto:${siteConfig.socials.email}`}
                        class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                    >{siteConfig.socials.email}</a>
                    （勘誤、衛教提問、學術合作；<strong class="text-foreground">不提供個別診療建議</strong>）
                </span>
            </p>
        )}
        {siteConfig.socials.line && (
            <p class="text-sm text-muted-foreground leading-relaxed">
                <strong class="text-foreground">讀者回饋管道</strong>：LINE 官方帳號
                <a
                    href={siteConfig.socials.line}
                    target="_blank"
                    rel="noopener"
                    class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                >@927pjtfa</a
                >
                ，接受文章勘誤建議、衛教問題提問、學術討論。
                <strong class="text-foreground">本管道不提供個別診療建議</strong>，亦不受理任何形式之醫療業務預約；具體病情、用藥、治療方案請與您的主治醫師面對面討論。
            </p>
        )}
    </section>

    <footer
        class="text-xs text-muted-foreground border-t border-border pt-6 leading-relaxed"
    >
        <p>
            本站文章所提供之資訊，僅供醫學新知與病人衛生教育參考，<strong
                >不構成個別醫療建議</strong
            >，亦不取代主治醫師之診療判斷。實際治療、用藥、手術選項，請與您的主治團隊討論後決定。
        </p>
    </footer>
</main>
