---
import {
    BookOpen,
    Briefcase,
    GraduationCap,
    IdCard,
    ShieldCheck,
    ExternalLink,
    Github,
    Mail,
    Wrench,
    Languages,
} from "@lucide/astro";

import { Image } from "astro:assets";
import avatar from "@/assets/images/avatar.jpg";
import { siteConfig } from "@/config";

interface SkillGroup {
    title: string;
    titleEn: string;
    body: string;
    bodyEn: string;
    repos: string[];
}

// Skills inventory grounded in the public repos at github.com/htlin222.
// Each item below is supported by one or more concrete repos in /portfolio so
// nothing here is generic AI-flavored padding — drop a repo, drop the claim.
const skills: SkillGroup[] = [
    {
        title: "臨床研究方法學",
        titleEn: "Clinical research methodology",
        body: "Meta-analysis、network meta-analysis、survival analysis（含 competing risks、immortal time、left truncation）、Bayesian target trial emulation、causal inference（DAG / propensity / TMLE）、real-world evidence（MMRM / CMH）。R + Quarto IMRAD pipeline，已用於 BTK 抑制劑、PARP 抑制劑、ICI 時序、咖啡因等多個 RCT 統合分析。",
        bodyEn:
            "Meta-analysis, network meta-analysis, survival analysis (competing risks, immortal-time bias, left truncation), Bayesian target trial emulation, causal inference (DAG / propensity scores / TMLE), and real-world evidence (MMRM / CMH). R + Quarto IMRAD pipeline applied to BTK inhibitors, PARP inhibitors, ICI timing, and other multi-RCT meta-analyses.",
        repos: [
            "meta-pipe",
            "robust-lit-review",
            "survival-pipe",
            "sepsis-dynamic-treatment-tt-emulation",
            "research-in-cancer-center",
            "hrd-parp-inhibitors",
            "btk-wm",
            "early-immuno-timing-nma",
            "ici-breast-cancer",
            "causal-tut",
            "TMLE-explain",
            "roche-vabysmo-rwe-workshop",
            "prisma-automation",
        ],
    },
    {
        title: "精準腫瘤學與多體學分析",
        titleEn: "Precision oncology & multi-omics",
        body: "NGS tertiary analysis（BAM → ESMO 2024 clinical report，含 OncoKB、AMP/ASCO/CAP、ESCAT 分級）、TCGA / METABRIC / SCAN-B 再分析、單細胞 RNA-seq 與 bulk transcriptomic 拓樸風險分層、機器學習於 AML 多體學藥物反應與乳癌放療反應預測。",
        bodyEn:
            "NGS tertiary analysis (BAM → ESMO 2024 clinical report with OncoKB, AMP/ASCO/CAP, ESCAT classification), TCGA / METABRIC / SCAN-B reanalysis, single-cell RNA-seq and bulk transcriptomic topological risk stratification, and machine learning for AML multi-omics drug response and breast cancer radiotherapy response prediction.",
        repos: [
            "ngs-tertiary-analysis-skills",
            "ngs-tertiary-analysis-paper",
            "tcga-brca-reanalysis",
            "topological-stratification-aml",
            "sctda-cancer-plasticity",
            "AML-MultiOmics-Predictor",
            "breast_cancer_radiogenomics",
            "flt3-signature-ml",
            "FoundationOne-to-Oncoprinter",
        ],
    },
    {
        title: "臨床決策 AI 與 MCP 工具開發",
        titleEn: "Clinical AI tooling & MCP servers",
        body: "建構與維護多個 MCP / Vercel Skills 套件：OpenEvidence 雙向整合 + Crossref 驗證、NCCN PDF 轉結構化 skill、EBMT 8e、Micromedex 風格 DDI、護理實證升等教練、Anki 整合。多套件以「parallel Haiku、anti-hallucination 引用驗證」為設計核心。發表 NEJM AI Perspective 級論文討論 LLM 診斷失敗模式。",
        bodyEn:
            "Author and maintainer of multiple MCP and Vercel Skills packages: OpenEvidence bi-directional integration with Crossref verification, NCCN PDF → structured AI skill, EBMT 8e guideline skill, Micromedex-style DDI assessment, Taiwan nursing-evidence promotion coach, and Anki integration. Design centred on parallel Haiku conversion and anti-hallucination citation enforcement. NEJM AI Perspective-style manuscript on LLM failure modes in diagnosis.",
        repos: [
            "openevidence-mcp",
            "openevidence-skill",
            "audit-oe-skill",
            "nccn-skill",
            "ebmt-handbook-skill",
            "drug-drug-skill",
            "cps-skills",
            "research-guardian-skill",
            "zh-ebn-report-skill",
            "llm-diagnosis-perspective",
            "llm-in-med",
            "yanki-mcp-server",
        ],
    },
    {
        title: "學術寫作與可重現研究",
        titleEn: "Academic writing & reproducible research",
        body: "Quarto / Pandoc / Typst / LaTeX 全流程；AMA、APA CSL；CrossRef DOI 驗證；BibTeX 多格式輸出；Docker 化 R 環境；醫療專用 cookiecutter 範本；已準備中的手稿涵蓋 NEJM AI、PLOS Medicine、American Psychologist、JCO 等期刊投稿風格。",
        bodyEn:
            "Full Quarto / Pandoc / Typst / LaTeX pipeline; AMA and APA CSL; CrossRef DOI verification; multi-format BibTeX output; Docker-ised R environments; medical cookiecutter templates. Manuscripts in preparation target NEJM AI, PLOS Medicine, American Psychologist, and JCO.",
        repos: [
            "academic-manuscript-workflow",
            "cookiecutter-quarto-research",
            "bestseller",
            "rocker",
            "meta-pipe-manuscript",
            "to-comfort-always",
            "flowdoc",
            "quarto-doc",
            "quarto_theme",
        ],
    },
    {
        title: "教學與訓練資源",
        titleEn: "Teaching & training resources",
        body: "ABIM 血液內科自製 72 主題 + 216 題、台灣 N1–N4 護理實證升等教練、臨床統計與因果推論視覺化（含 TMLE / DAG / propensity score 動畫）、Network meta-analysis with R 中文教學；ASH 2026 Asia-Pacific 與 ASH B-cell lymphoma 系列 Reveal.js 簡報。",
        bodyEn:
            "Self-authored ABIM Hematology bank (72 topics + 216 questions); Taiwan N1–N4 nursing evidence-based promotion coach; visualised clinical statistics and causal inference (TMLE / DAG / propensity score animations); Chinese-language Network Meta-analysis with R tutorial; Reveal.js decks for ASH 2026 Asia-Pacific and ASH B-cell lymphoma updates.",
        repos: [
            "hematology-board-review",
            "pocket-hematology",
            "zh-ebn-report-skill",
            "calculus-for-medstats",
            "r-nma",
            "r-with-ai-eng",
            "learn-r-with-ai",
            "HOASH-2026-Asia",
            "ASH-MCL",
            "qbank2anki",
            "anki_batch",
        ],
    },
    {
        title: "醫院流程自動化",
        titleEn: "Hospital workflow automation",
        body: "KFSYSCC IRB 文件批次生成（43 表單、11 類別、一鍵）、TMA 月度繼續教育、教育部學術倫理課程、醫學會行事曆 → Google Calendar、北榮泌尿部排班系統、e-portfolio 教學評核、新生兒奶量計算、病理面積六角格量測。",
        bodyEn:
            "KFSYSCC IRB document batch generator (43 forms, 11 categories, one command); Taiwan Medical Association monthly CME automation; Ministry of Education research-ethics course completion; medical-society calendar → Google Calendar sync; Taipei VGH urology scheduler; e-portfolio teaching-evaluation filler; neonatal milk calculator; pathology hex-grid area measurement.",
        repos: [
            "irb-in-hurry",
            "irb-time",
            "tma-edu-exam",
            "auto-tms",
            "society-calendar",
            "vghtpe-uro",
            "education-portfolio",
            "duty_scheduler",
            "milkCalc",
            "areacalc",
            "hemonc-daily-case",
        ],
    },
];

const techStack = [
    "R / Quarto",
    "Python",
    "TypeScript / Astro",
    "LaTeX / Typst / Pandoc",
    "Claude Code / Codex / MCP",
    "Docker / Cloudflare Workers",
    "GitHub Actions",
];

const certificationsZh = [
    "台灣內科醫學會 內科專科醫師",
    "台灣癌症醫學會 腫瘤內科專科醫師",
];

const certificationsEn = [
    "Board-Certified Internist, Taiwan Society of Internal Medicine",
    "Board-Certified Medical Oncologist, Taiwan Oncology Society",
];

const principlesZh = [
    {
        title: "依國際指引",
        body: "臨床主題以 NCCN、ASCO、ESMO 最新版指引、以及 PubMed 索引論文為主要來源，並比對台灣腫瘤醫學會、國健署資料。",
    },
    {
        title: "署名審稿、標註日期",
        body: "每篇醫療相關文章皆由本人署名審稿，文末顯示審稿日期與最後更新日期；新版指引釋出時依年度重審。",
    },
    {
        title: "符合醫療法 §87",
        body: "本站屬醫療法第 87 條第 2 項所定之醫學新知與病人衛生教育，不從事醫療業務招徠，避免「保證、根治、最有效、永不復發」等違反法規之用語。",
    },
    {
        title: "個案資料去識別化",
        body: "若引用個案經驗，必經充分去識別化處理，並僅以教學、衛教為目的；不公開可辨識病人身分之內容。",
    },
];

const principlesEn = [
    {
        title: "Guideline-grounded",
        body: "Clinical topics anchored on current NCCN, ASCO, and ESMO guidelines and PubMed-indexed literature; cross-checked against Taiwan Oncology Society and HPA sources.",
    },
    {
        title: "Signed clinical review with dated stamps",
        body: "Every medical post is reviewed under my name; review and last-updated dates are shown at the foot of each article and refreshed when guidelines update.",
    },
    {
        title: "Compliant with Medical Care Act §87",
        body: "This site operates under Article 87.2 as medical news and patient education; absolute terms (e.g. \"guarantee\", \"cure\", \"most effective\", \"no recurrence\") prohibited by the law are avoided.",
    },
    {
        title: "De-identified case material",
        body: "Any patient case used is fully de-identified — age range only, no unit or date — and used solely for teaching purposes.",
    },
];

const profileLinks = [
    {
        label: "ORCID 0009-0002-3974-4528",
        href: siteConfig.author.orcid,
    },
    {
        label: "Google Scholar",
        href: siteConfig.author.scholar,
    },
    {
        label: "GitHub @htlin222",
        href: siteConfig.socials.github,
    },
].filter((p) => p.href);

const bioEn =
    "Hematology & Medical Oncology Fellow at Koo Foundation Sun Yat-Sen Cancer Center, Taipei. Clinical notes and reading log.";
---

<main class="page flex flex-col space-y-10 max-w-3xl mx-auto pb-20">
    {/* ── Hero (shared) ── */}
    <section class="pt-6 flex flex-col sm:flex-row gap-6 items-start">
        <Image
            src={avatar}
            alt={`${siteConfig.author.name} ${siteConfig.author.credentials ?? ""}`.trim()}
            width={320}
            height={320}
            loading="eager"
            class="shrink-0 rounded-full object-cover border border-border"
            style="width: 7rem; height: 7rem;"
        />
        <div class="flex-1 min-w-0">
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">
                林協霆 M.D. · Hsieh-Ting Lin
            </h1>
            <p class="text-muted-foreground mt-1">
                {siteConfig.author.specialty}
            </p>
            <p class="mt-4 text-sm leading-relaxed" data-bio-zh>
                {siteConfig.author.bio}
            </p>
            <p class="mt-4 text-sm leading-relaxed" data-bio-en hidden>
                {bioEn}
            </p>
            <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs sm:text-sm">
                {profileLinks.map((p) => (
                    <li>
                        <a
                            href={p.href}
                            target="_blank"
                            rel="me noopener"
                            class="inline-flex items-center gap-1 hover:text-primary transition-colors underline-offset-4 hover:underline"
                        >
                            <ExternalLink size={13} />
                            {p.label}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    {/* ── Language tabs ── */}
    <div
        role="tablist"
        aria-label="About language"
        class="inline-flex rounded-md border border-border overflow-hidden text-sm self-start"
    >
        <button
            type="button"
            role="tab"
            id="about-tab-zh"
            aria-controls="about-panel-zh"
            aria-selected="true"
            data-about-tab="zh"
            class="about-tab inline-flex items-center gap-1.5 px-4 py-1.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary aria-selected:bg-foreground aria-selected:text-background"
        >
            <Languages size={14} />
            繁體中文
        </button>
        <button
            type="button"
            role="tab"
            id="about-tab-en"
            aria-controls="about-panel-en"
            aria-selected="false"
            data-about-tab="en"
            class="about-tab inline-flex items-center gap-1.5 px-4 py-1.5 border-l border-border transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary aria-selected:bg-foreground aria-selected:text-background"
        >
            <Languages size={14} />
            English
        </button>
    </div>

    {/* ── 繁體中文 ── */}
    <div
        id="about-panel-zh"
        role="tabpanel"
        aria-labelledby="about-tab-zh"
        data-about-panel="zh"
        class="flex flex-col space-y-12"
    >
        <section class="space-y-3 text-sm leading-relaxed">
            <h2 class="text-xl font-semibold">關於我</h2>
            <p>
                林協霆，和信治癌中心醫院血液腫瘤科專研醫師（2023–），國立成功大學醫學系畢業，內科與腫瘤內科雙專科。臨床涵蓋肺、乳、大腸、肝、攝護腺等實體瘤，與淋巴瘤、白血病、骨髓瘤、再生不良性貧血等血液腫瘤；熟悉 NCCN／ASCO／ESMO 跨指引差異與台灣健保條件。
            </p>
            <p>
                研究專注於<strong class="text-foreground">統合分析、網絡統合分析、生存分析、Bayesian target trial emulation、因果推論</strong>（DAG／傾向分數／TMLE），以 R + Quarto IMRAD pipeline 完成 BTK 抑制劑、PARP 抑制劑、ICI 時序等多個專案；同時建構 <strong class="text-foreground">NGS tertiary 分析、TCGA／SCAN-B 再分析、AML 多體學機器學習</strong>等精準腫瘤學工具。
            </p>
            <p>
                在「臨床 × AI」交界，釋出多個開源 MCP／Vercel Skills 套件（<strong class="text-foreground">OpenEvidence、NCCN、EBMT、Micromedex 風格 DDI</strong>），核心設計為「parallel Haiku + anti-hallucination 引用驗證」；正在準備 NEJM AI、PLOS Medicine 等期刊投稿。長期目標是把可重現研究、引用驗證與臨床決策整合在一起。
            </p>
        </section>

        <section class="space-y-3 text-sm leading-relaxed">
            <h2 class="text-xl font-semibold">關於本站</h2>
            <p>本站為腫瘤內科臨床筆記、衛教整理與閱讀記錄，主要服務兩種讀者：</p>
            <ul class="list-disc list-outside ml-5 space-y-1.5">
                <li>
                    <strong>病友與家屬</strong>：以「病人真正會問」的問題切入，整理治療選項、副作用、與決策時可帶去診間的問題清單。
                </li>
                <li>
                    <strong>同業與住院醫師</strong>：整理新藥臨床試驗、跨指引差異、以及臨床上未必能立刻找到實證的灰色地帶。
                </li>
            </ul>
            <p>
                本站不取代主治醫師之診療判斷，亦不從事醫療業務招徠。實際治療決策請與您的醫療團隊面對面討論。
            </p>
        </section>

        <section class="space-y-4">
            <h2 class="flex items-center gap-2 text-xl font-semibold">
                <ShieldCheck size={20} class="text-primary" /> 編輯方針 · Editorial Policy
            </h2>
            <ol class="list-decimal list-outside ml-5 space-y-3 text-sm leading-relaxed marker:text-muted-foreground">
                {principlesZh.map((p) => (
                    <li>
                        <strong class="text-foreground">{p.title}</strong>
                        <span class="text-muted-foreground"> — {p.body}</span>
                    </li>
                ))}
            </ol>
        </section>

        <section class="space-y-4">
            <h2 class="flex items-center gap-2 text-xl font-semibold">
                <Wrench size={20} class="text-primary" /> 技能與作品 · Skills
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                以下技能項目皆對應公開的
                <a
                    href="/portfolio"
                    class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                    >GitHub repos</a
                >；點擊任一專案標籤可直接跳到該 repo 檢視程式碼、文件與最近更新。
            </p>

            <div class="flex flex-wrap gap-1.5 pb-2">
                {techStack.map((t) => (
                    <span class="inline-flex items-center px-2 py-0.5 rounded border border-border bg-muted text-xs text-muted-foreground">
                        {t}
                    </span>
                ))}
            </div>

            <ol class="list-decimal list-outside ml-5 space-y-5 text-sm leading-relaxed marker:text-muted-foreground">
                {skills.map((s) => (
                    <li>
                        <div>
                            <strong class="text-foreground">{s.title}</strong>
                            <span class="text-muted-foreground"> · {s.titleEn}</span>
                        </div>
                        <p class="mt-1 text-muted-foreground">{s.body}</p>
                        <div class="mt-2 flex flex-wrap gap-1.5">
                            {s.repos.map((r) => (
                                <a
                                    href={`https://github.com/htlin222/${r}`}
                                    target="_blank"
                                    rel="noopener"
                                    class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded border border-border bg-card text-xs text-foreground/85 hover:text-primary hover:border-primary transition-colors"
                                >
                                    {r}
                                    <ExternalLink size={9} class="opacity-60" />
                                </a>
                            ))}
                        </div>
                    </li>
                ))}
            </ol>

            <p class="text-xs text-muted-foreground leading-relaxed pt-2">
                完整 210 個公開 repos（醫療 79 + IT 131）依時間排序見
                <a
                    href="/portfolio"
                    class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                    >/portfolio</a
                >。學術發表以
                <a
                    href={siteConfig.author.scholar}
                    target="_blank"
                    rel="me noopener"
                    class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                    >Google Scholar</a
                >
                為準；歷年口頭報告與證照見
                <a
                    href="/cv"
                    class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                    >CV</a
                >。
            </p>
        </section>

        <section class="space-y-3">
            <h2 class="flex items-center gap-2 text-xl font-semibold">
                <Briefcase size={20} class="text-muted-foreground" /> 現職
            </h2>
            <ul class="text-sm leading-relaxed">
                <li class="grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-4">
                    <span class="text-muted-foreground tabular-nums pt-0.5">2023.08 –</span>
                    <div>
                        <p class="font-medium">血液腫瘤科專研醫師（Fellow）</p>
                        <p class="text-muted-foreground">
                            {siteConfig.author.affiliationUrl ? (
                                <a
                                    href={siteConfig.author.affiliationUrl}
                                    target="_blank"
                                    rel="noopener"
                                    class="hover:text-primary transition-colors underline-offset-4 hover:underline"
                                >
                                    {siteConfig.author.affiliation}
                                </a>
                            ) : (
                                siteConfig.author.affiliation
                            )}
                        </p>
                    </div>
                </li>
            </ul>
        </section>

        <section class="space-y-3">
            <h2 class="flex items-center gap-2 text-xl font-semibold">
                <GraduationCap size={20} class="text-muted-foreground" /> 學歷
            </h2>
            <ul class="text-sm leading-relaxed">
                <li class="grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-4">
                    <span class="text-muted-foreground tabular-nums pt-0.5">2013 – 2019</span>
                    <div>
                        <p class="font-medium">醫學系（Doctor of Medicine）</p>
                        <p class="text-muted-foreground">
                            國立成功大學 National Cheng Kung University
                        </p>
                    </div>
                </li>
            </ul>
        </section>

        <section class="space-y-3">
            <h2 class="flex items-center gap-2 text-xl font-semibold">
                <IdCard size={20} class="text-muted-foreground" /> 專科證照
            </h2>
            <ul class="list-disc list-outside ml-5 space-y-1.5 text-sm marker:text-muted-foreground">
                {certificationsZh.map((c) => <li>{c}</li>)}
            </ul>
        </section>

        <section class="space-y-3">
            <h2 class="flex items-center gap-2 text-xl font-semibold">
                <BookOpen size={20} class="text-muted-foreground" /> 完整學經歷與發表
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                完整現職、經歷、發表、口頭報告與專科證照清單，請見
                <a
                    href="/cv"
                    class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                    >CV 頁</a
                >；學術發表與引用以
                <a
                    href={siteConfig.author.scholar}
                    target="_blank"
                    rel="me noopener"
                    class="text-foreground font-medium underline-offset-4 hover:underline hover:text-primary"
                    >Google Scholar</a
                >
                為準。
            </p>
        </section>

        <section class="space-y-3 pt-2 border-t border-border">
            <h2 class="flex items-center gap-2 text-xl font-semibold pt-6">
                <Github size={20} class="text-muted-foreground" /> 聯絡與更新
