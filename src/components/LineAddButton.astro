---
// Official LINE "加入好友 / Add Friend" button. The PNG + lin.ee shortlink are
// LINE's canonical assets, kept here as a single component so every UI surface
// (footer, medical disclaimer, about page) stays in sync.
import { siteConfig } from "@/config";

interface Props {
    height?: number;
    class?: string;
}

const { height = 18, class: className = "" } = Astro.props;
---

{
    siteConfig.socials.line && (
        <a
            href={siteConfig.socials.line}
            target="_blank"
            rel="noreferrer"
            aria-label="加入 LINE 官方帳號 @927pjtfa（讀者回饋專用，不提供個別診療建議）"
            title="加入 LINE 官方帳號（勘誤／衛教提問／學術討論，不提供個別診療建議）"
            class:list={["inline-flex items-center align-middle", className]}
        >
            <img
                src="https://scdn.line-apps.com/n/line_add_friends/btn/zh-Hant.png"
                alt="加入好友"
                height={height}
                style="border:0"
                loading="lazy"
            />
        </a>
    )
}
