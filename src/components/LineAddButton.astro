---
// Custom LINE pill — brand green (#00B900) with rounded corners, kept in a
// single component so footer / medical disclaimer / about pages stay in sync.
import { siteConfig } from "@/config";

interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;
---

{
    siteConfig.socials.line && (
        <a
            href={siteConfig.socials.line}
            target="_blank"
            rel="noreferrer"
            aria-label="加入 LINE 官方帳號 @927pjtfa（讀者回饋專用，不提供個別診療建議）"
            title="加入 LINE 官方帳號（勘誤／衛教提問／學術討論，不提供個別診療建議）"
            class:list={[
                "inline-flex items-center gap-1 align-middle rounded-full px-3 py-0.5 text-xs font-medium text-white no-underline hover:opacity-90 transition-opacity",
                className,
            ]}
            style="background-color:#00B900;"
        >
            <span aria-hidden="true">💬</span>
            <span>LINE</span>
        </a>
    )
}
