---
import Layout from "@/layouts/Layout.astro";
import {
    ExternalLink,
    GraduationCap,
    BookOpen,
    Mic,
    Briefcase,
    IdCard,
    FileDown,
    Languages,
} from "@lucide/astro";
import {
    positions,
    experience,
    education,
    publications,
    presentations,
    certifications,
    certificationsEn,
    profiles,
    cvHeader,
} from "@/data/cv";
---

<Layout
    title="CV | 林協霆 · Hsieh-Ting Lin"
    description="林協霆 M.D. — Attending Physician, Medical Oncology. CV (zh-TW + English)."
>
    <main class="px-6 sm:px-8 max-w-3xl mx-auto pb-20">
        <header class="pt-6 pb-8 border-b border-border">
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">
                {cvHeader.nameZh} {cvHeader.credentialsZh}
            </h1>
            <p class="text-muted-foreground mt-2">
                {cvHeader.nameEn} · {cvHeader.taglineZh}
            </p>
            <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
                {
                    profiles.map((p) => (
                        <li>
                            <a
                                href={p.href}
                                target="_blank"
                                rel="noopener"
                                class="inline-flex items-center gap-1.5 hover:text-primary transition-colors underline-offset-4 hover:underline"
                            >
                                <ExternalLink size={13} />
                                {p.label}
                            </a>
                        </li>
                    ))
                }
                <li>
                    <a
                        href={`mailto:${cvHeader.email}`}
                        class="inline-flex items-center gap-1.5 hover:text-primary transition-colors underline-offset-4 hover:underline"
                    >
                        <ExternalLink size={13} />
                        {cvHeader.email}
                    </a>
                </li>
            </ul>
            <div class="mt-5 flex flex-wrap gap-3 text-sm">
                <a
                    href="/pdf/cv-zh.pdf"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-border hover:border-primary hover:text-primary transition-colors"
                >
                    <FileDown size={14} />
                    一頁版 CV (zh-TW PDF)
                </a>
                <a
                    href="/pdf/cv-en.pdf"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-border hover:border-primary hover:text-primary transition-colors"
                >
                    <FileDown size={14} />
                    One-page CV (English PDF)
                </a>
            </div>

            <div
                role="tablist"
                aria-label="CV language"
                class="mt-6 inline-flex rounded-md border border-border overflow-hidden text-sm"
            >
                <button
                    type="button"
                    role="tab"
                    id="tab-en"
                    aria-controls="cv-en"
                    aria-selected="true"
                    data-cv-tab="en"
                    class="cv-tab inline-flex items-center gap-1.5 px-4 py-1.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary aria-selected:bg-foreground aria-selected:text-background"
                >
                    <Languages size={14} />
                    English
                </button>
                <button
                    type="button"
                    role="tab"
                    id="tab-zh"
                    aria-controls="cv-zh"
                    aria-selected="false"
                    data-cv-tab="zh"
                    class="cv-tab inline-flex items-center gap-1.5 px-4 py-1.5 border-l border-border transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary aria-selected:bg-foreground aria-selected:text-background"
                >
                    <Languages size={14} />
                    繁體中文
                </button>
            </div>
        </header>

        {/* ── ENGLISH SECTION (default active tab) ── */}
        <section
            id="cv-en"
            role="tabpanel"
            aria-labelledby="tab-en"
            data-cv-panel="en"
            class="pt-10"
        >
            <h2 class="sr-only">Curriculum Vitae · English</h2>
            <p class="text-sm text-muted-foreground mt-1">
                {cvHeader.taglineEn}
            </p>

            <div class="mt-8 space-y-10">
                <section>
                    <h3 class="flex items-center gap-2 text-xl font-semibold mb-4">
                        <Briefcase size={18} class="text-muted-foreground" />
                        Current Position
                    </h3>
                    <ul class="space-y-4">
                        {
                            positions.map((p) => (
                                <li class="grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-4">
                                    <span class="text-sm text-muted-foreground tabular-nums pt-0.5">
                                        {p.period}
                                    </span>
                                    <div>
                                        <p class="font-medium">{p.titleEn}</p>
                                        <p class="text-sm text-muted-foreground">{p.orgEn}</p>
                                    </div>
                                </li>
                            ))
                        }
                    </ul>
                </section>

                <section>
                    <h3 class="flex items-center gap-2 text-xl font-semibold mb-4">
                        <Briefcase size={18} class="text-muted-foreground" />
                        Clinical Training
                    </h3>
                    <ul class="space-y-4">
                        {
                            experience.map((e) => (
                                <li class="grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-4">
                                    <span class="text-sm text-muted-foreground tabular-nums pt-0.5">
                                        {e.period}
                                    </span>
                                    <div>
                                        <p class="font-medium">{e.titleEn}</p>
                                        <p class="text-sm text-muted-foreground">{e.orgEn}</p>
                                    </div>
                                </li>
                            ))
                        }
                    </ul>
                </section>

                <section>
                    <h3 class="flex items-center gap-2 text-xl font-semibold mb-4">
                        <GraduationCap size={18} class="text-muted-foreground" />
                        Education
                    </h3>
                    <ul class="space-y-4">
                        {
                            education.map((e) => (
                                <li class="grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-4">
                                    <span class="text-sm text-muted-foreground tabular-nums pt-0.5">
                                        {e.period}
                                    </span>
                                    <div>
                                        <p class="font-medium">{e.titleEn}</p>
                                        <p class="text-sm text-muted-foreground">{e.orgEn}</p>
                                    </div>
                                </li>
                            ))
                        }
                    </ul>
                </section>

                <section>
                    <h3 class="flex items-center gap-2 text-xl font-semibold mb-4">
                        <BookOpen size={18} class="text-muted-foreground" />
                        Publications
                    </h3>
                    <ol
                        class="space-y-4 list-decimal list-outside ml-5 marker:text-muted-foreground marker:tabular-nums"
                    >
                        {
                            publications.map((p) => (
                                <li>
                                    <p class="text-sm leading-relaxed">
                                        <span class="text-muted-foreground">{p.authors}</span>{" "}
                                        {p.url ? (
                                            <a
                                                href={p.url}
                                                target="_blank"
                                                rel="noopener"
                                                class="underline-offset-4 hover:underline hover:text-primary"
                                            >
                                                {p.title}
                                            </a>
                                        ) : (
                                            <span>{p.title}</span>
                                        )}{" "}
                                        <span class="italic text-muted-foreground">
                                            {p.venue}
                                        </span>
                                    </p>
                                </li>
                            ))
                        }
                    </ol>
                </section>

                <section>
                    <h3 class="flex items-center gap-2 text-xl font-semibold mb-4">
                        <Mic size={18} class="text-muted-foreground" />
                        Oral Presentations
                    </h3>
                    <ul class="space-y-4">
                        {
                            presentations.map((t) => (
                                <li class="grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-4">
                                    <span class="text-sm text-muted-foreground tabular-nums pt-0.5">
                                        {t.date}
                                    </span>
                                    <div>
                                        <p class="text-sm leading-relaxed">{t.title}</p>
                                        <p class="text-xs text-muted-foreground mt-0.5">
                                            {t.venueEn}
                                        </p>
                                    </div>
                                </li>
                            ))
                        }
                    </ul>
                </section>

                <section>
                    <h3 class="flex items-center gap-2 text-xl font-semibold mb-4">
                        <IdCard size={18} class="text-muted-foreground" />
                        Board Certifications
                    </h3>
                    <ul
                        class="list-disc list-outside ml-5 space-y-1.5 marker:text-muted-foreground"
                    >
                        {certificationsEn.map((c) => <li class="text-sm">{c}</li>)}
                    </ul>
                </section>
            </div>
        </section>

        {/* ── 中文版（tab-controlled） ── */}
        <section
            id="cv-zh"
            role="tabpanel"
            aria-labelledby="tab-zh"
            data-cv-panel="zh"
            hidden
            class="pt-10"
        >
            <h2 class="sr-only">履歷 · 繁體中文</h2>
            <p class="text-sm text-muted-foreground mt-1">{cvHeader.taglineZh}</p>

            <div class="mt-8 space-y-10">
                <section>
                    <h3 class="flex items-center gap-2 text-xl font-semibold mb-4">
                        <Briefcase size={18} class="text-muted-foreground" /> 現職
                    </h3>
                    <ul class="space-y-4">
                        {
                            positions.map((p) => (
                                <li class="grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-4">
                                    <span class="text-sm text-muted-foreground tabular-nums pt-0.5">
                                        {p.period}
                                    </span>
                                    <div>
                                        <p class="font-medium">{p.title}</p>
                                        <p class="text-sm text-muted-foreground">{p.org}</p>
                                    </div>
                                </li>
                            ))
                        }
                    </ul>
                </section>

                <section>
                    <h3 class="flex items-center gap-2 text-xl font-semibold mb-4">
                        <Briefcase size={18} class="text-muted-foreground" /> 主要經歷
                    </h3>
                    <ul class="space-y-4">
                        {
                            experience.map((e) => (
                                <li class="grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-4">
                                    <span class="text-sm text-muted-foreground tabular-nums pt-0.5">
                                        {e.period}
                                    </span>
                                    <div>
                                        <p class="font-medium">{e.title}</p>
                                        <p class="text-sm text-muted-foreground">{e.org}</p>
                                    </div>
                                </li>
                            ))
                        }
                    </ul>
                </section>

                <section>
                    <h3 class="flex items-center gap-2 text-xl font-semibold mb-4">
                        <GraduationCap size={18} class="text-muted-foreground" /> 學歷
                    </h3>
                    <ul class="space-y-4">
                        {
                            education.map((e) => (
                                <li class="grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-4">
                                    <span class="text-sm text-muted-foreground tabular-nums pt-0.5">
                                        {e.period}
                                    </span>
                                    <div>
                                        <p class="font-medium">{e.title}</p>
                                        <p class="text-sm text-muted-foreground">{e.org}</p>
                                    </div>
                                </li>
                            ))
                        }
                    </ul>
                </section>

                <section>
                    <h3 class="flex items-center gap-2 text-xl font-semibold mb-4">
                        <BookOpen size={18} class="text-muted-foreground" /> Publications
                    </h3>
                    <ol
                        class="space-y-4 list-decimal list-outside ml-5 marker:text-muted-foreground marker:tabular-nums"
                    >
                        {
                            publications.map((p) => (
                                <li>
                                    <p class="text-sm leading-relaxed">
                                        <span class="text-muted-foreground">{p.authors}</span>{" "}
                                        {p.url ? (
                                            <a
                                                href={p.url}
                                                target="_blank"
                                                rel="noopener"
                                                class="underline-offset-4 hover:underline hover:text-primary"
                                            >
                                                {p.title}
                                            </a>
                                        ) : (
                                            <span>{p.title}</span>
                                        )}{" "}
                                        <span class="italic text-muted-foreground">
                                            {p.venue}
                                        </span>
                                    </p>
                                </li>
                            ))
                        }
                    </ol>
                </section>

                <section>
                    <h3 class="flex items-center gap-2 text-xl font-semibold mb-4">
                        <Mic size={18} class="text-muted-foreground" /> Oral Presentations
                    </h3>
                    <ul class="space-y-4">
                        {
                            presentations.map((t) => (
                                <li class="grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-4">
                                    <span class="text-sm text-muted-foreground tabular-nums pt-0.5">
                                        {t.date}
                                    </span>
                                    <div>
                                        <p class="text-sm leading-relaxed">{t.title}</p>
                                        <p class="text-xs text-muted-foreground mt-0.5">
                                            {t.venue}
                                        </p>
                                    </div>
                                </li>
                            ))
                        }
                    </ul>
                </section>

                <section>
                    <h3 class="flex items-center gap-2 text-xl font-semibold mb-4">
                        <IdCard size={18} class="text-muted-foreground" /> 專科證照
                    </h3>
                    <ul
                        class="list-disc list-outside ml-5 space-y-1.5 marker:text-muted-foreground"
                    >
                        {certifications.map((c) => <li class="text-sm">{c}</li>)}
                    </ul>
                </section>
            </div>
        </section>

        <footer class="pt-12 mt-12 border-t border-border text-xs text-muted-foreground">
            <p>
                聯絡 / Contact:
                <a
                    href={`mailto:${cvHeader.email}`}
                    class="underline-offset-4 hover:underline ml-1"
                >
                    {cvHeader.email}
                </a>
                ·
                <a
                    href="https://github.com/htlin222"
                    class="underline-offset-4 hover:underline ml-1"
                    target="_blank"
                    rel="noopener">GitHub</a
                > ·
                <a
                    href="https://orcid.org/0009-0002-3974-4528"
                    class="underline-offset-4 hover:underline ml-1"
                    target="_blank"
                    rel="noopener">ORCID</a
                >
            </p>
        </footer>
    </main>
</Layout>

<script>
    type Lang = "en" | "zh";

    const tabs = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-cv-tab]"),
    );
    const panels = Array.from(
        document.querySelectorAll<HTMLElement>("[data-cv-panel]"),
    );

    function activate(name: Lang) {
        for (const t of tabs) {
            const active = t.dataset.cvTab === name;
            t.setAttribute("aria-selected", String(active));
            t.tabIndex = active ? 0 : -1;
        }
        for (const p of panels) {
            p.hidden = p.dataset.cvPanel !== name;
        }
        try {
            localStorage.setItem("cv-lang", name);
            localStorage.setItem("site-lang", name);
        } catch {}
        // Keep global UI lang in sync.
        document.documentElement.dataset.lang = name;
        if (location.hash !== `#${name}`) {
            history.replaceState(null, "", `#${name}`);
        }
    }

    function initialLang(): Lang {
        const hash = location.hash.replace("#", "");
        if (hash === "zh" || hash === "en" || hash === "cv-zh" || hash === "cv-en") {
            return hash.endsWith("zh") ? "zh" : "en";
        }
        try {
            const site = localStorage.getItem("site-lang");
            if (site === "zh" || site === "en") return site;
            if (site === "ja") return "zh"; // CV tabs only support zh/en
            const saved = localStorage.getItem("cv-lang");
            if (saved === "zh" || saved === "en") return saved;
        } catch {}
        return "en";
    }

    for (const t of tabs) {
        t.addEventListener("click", () => {
            const name = t.dataset.cvTab as Lang | undefined;
            if (name) activate(name);
        });
        t.addEventListener("keydown", (e) => {
            if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
            e.preventDefault();
            const order: Lang[] = ["en", "zh"];
            const current = order.indexOf(t.dataset.cvTab as Lang);
            const next =
                order[(current + (e.key === "ArrowRight" ? 1 : -1) + order.length) % order.length];
            const target = document.querySelector<HTMLButtonElement>(
                `[data-cv-tab="${next}"]`,
            );
            target?.focus();
            activate(next);
        });
    }

    activate(initialLang());

    window.addEventListener("hashchange", () => {
        const hash = location.hash.replace("#", "");
        if (hash === "zh" || hash === "cv-zh") activate("zh");
        else if (hash === "en" || hash === "cv-en") activate("en");
    });
</script>

<style>
    /* When printing, show both panels so the printed page is complete regardless of tab state. */
    @media print {
        [data-cv-panel][hidden] {
            display: block !important;
        }
    }
</style>
