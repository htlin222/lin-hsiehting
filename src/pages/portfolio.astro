---
import Layout from "@/layouts/Layout.astro";
import {
    Github,
    Star,
    Stethoscope,
    Code2,
    ExternalLink,
    Calendar,
    Tag,
} from "@lucide/astro";
import portfolio from "@/data/github-portfolio.json";

interface Repo {
    name: string;
    description: string;
    language: string | null;
    stars: number;
    pushedAt: string;
    createdAt: string;
    topics: string[];
    url: string;
    homepage: string | null;
    license: string | null;
    defaultBranch: string;
    category: "medical" | "it";
    readmeExcerpt?: string | null;
}

const repos = portfolio.repos as Repo[];
const fetchedAt = new Date(portfolio.fetchedAt);

const medical = repos.filter((r) => r.category === "medical");
const it = repos.filter((r) => r.category === "it");

const fmtDate = (iso: string) => {
    const d = new Date(iso);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
};

// Stable language colour mapping (top languages only — others use the muted tone).
const langColor: Record<string, string> = {
    Python: "bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/30",
    TypeScript: "bg-sky-500/10 text-sky-700 dark:text-sky-300 border-sky-500/30",
    JavaScript: "bg-yellow-500/10 text-yellow-700 dark:text-yellow-300 border-yellow-500/30",
    R: "bg-blue-700/10 text-blue-800 dark:text-blue-300 border-blue-700/30",
    TeX: "bg-emerald-700/10 text-emerald-800 dark:text-emerald-300 border-emerald-700/30",
    Lua: "bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border-indigo-500/30",
    Shell: "bg-zinc-500/10 text-zinc-700 dark:text-zinc-300 border-zinc-500/30",
    HTML: "bg-orange-500/10 text-orange-700 dark:text-orange-300 border-orange-500/30",
    MDX: "bg-violet-500/10 text-violet-700 dark:text-violet-300 border-violet-500/30",
};

const langClass = (lang: string | null) =>
    lang && langColor[lang]
        ? langColor[lang]
        : "bg-muted text-muted-foreground border-border";

const sections = [
    {
        id: "medical",
        title: "醫療 · Medical & Clinical",
        Icon: Stethoscope,
        repos: medical,
        description: "腫瘤、血液、臨床研究、教學、AI 工具與資料分析。",
    },
    {
        id: "it",
        title: "IT · Developer Tools",
        Icon: Code2,
        repos: it,
        description: "dev tools、Claude / Codex 整合、生產力與娛樂專案。",
    },
];
---

<Layout
    title="Portfolio | 林協霆 · Hsieh-Ting Lin"
    description={`${portfolio.count} 個 GitHub 開源專案，醫療 ${portfolio.medicalCount} + IT ${portfolio.itCount}，依最近更新排序。`}
>
    <main class="px-6 sm:px-8 max-w-5xl mx-auto pb-20">
        <header class="pt-6 pb-8 border-b border-border">
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">
                Portfolio
            </h1>
            <p class="text-muted-foreground mt-2">
                <a
                    href="https://github.com/htlin222"
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1.5 hover:text-primary transition-colors underline-offset-4 hover:underline"
                >
                    <Github size={14} /> github.com/htlin222
                </a>
                · {portfolio.count} 個 repo · 醫療 {portfolio.medicalCount} · IT {portfolio.itCount}
            </p>
            <p class="text-xs text-muted-foreground mt-1">
                最近同步：{fmtDate(fetchedAt.toISOString())} · 自動匯入：
                <code class="text-xs">pnpm run portfolio:fetch</code>
            </p>

            <nav class="mt-6 flex flex-wrap gap-2 text-sm">
                {sections.map((s) => (
                    <a
                        href={`#${s.id}`}
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-border hover:border-primary hover:text-primary transition-colors"
                    >
                        <s.Icon size={14} /> {s.title.split(" · ")[0]} ({s.repos.length})
                    </a>
                ))}
            </nav>
        </header>

        {sections.map(({ id, title, Icon, repos: list, description }) => (
            <section id={id} class="pt-10 scroll-mt-24">
                <h2 class="flex items-center gap-2 text-2xl font-bold tracking-tight">
                    <Icon size={22} class="text-muted-foreground" /> {title}
                </h2>
                <p class="text-sm text-muted-foreground mt-1">{description}</p>

                <ul class="mt-6 grid gap-4 sm:grid-cols-2">
                    {list.map((r) => (
                        <li class="group flex flex-col p-4 rounded-lg border border-border hover:border-primary transition-colors bg-card">
                            <div class="flex items-start justify-between gap-2">
                                <h3 class="font-semibold text-base leading-tight">
                                    <a
                                        href={r.url}
                                        target="_blank"
                                        rel="noopener"
                                        class="hover:text-primary inline-flex items-center gap-1"
                                    >
                                        {r.name}
                                        <ExternalLink size={11} class="opacity-60" />
                                    </a>
                                </h3>
                                {r.stars > 0 && (
                                    <span class="shrink-0 inline-flex items-center gap-0.5 text-xs text-muted-foreground tabular-nums">
                                        <Star size={11} class="text-amber-500 fill-amber-500" />
                                        {r.stars}
                                    </span>
                                )}
                            </div>

                            {r.description && (
                                <p class="text-sm text-foreground/85 mt-1.5 leading-relaxed">
                                    {r.description}
                                </p>
                            )}

                            {r.readmeExcerpt &&
                                r.readmeExcerpt !== r.description &&
                                !r.description.includes(r.readmeExcerpt.slice(0, 60)) && (
                                    <p class="text-xs text-muted-foreground mt-2 leading-relaxed line-clamp-3">
                                        {r.readmeExcerpt}
                                    </p>
                                )}

                            <div class="mt-3 flex flex-wrap items-center gap-1.5 text-xs">
                                {r.language && (
                                    <span class={`inline-flex items-center px-1.5 py-0.5 rounded border ${langClass(r.language)}`}>
                                        {r.language}
                                    </span>
                                )}
                                {r.topics.slice(0, 4).map((t) => (
                                    <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-muted text-muted-foreground border border-border">
                                        <Tag size={9} />
                                        {t}
                                    </span>
                                ))}
                                {r.topics.length > 4 && (
                                    <span class="text-muted-foreground">+{r.topics.length - 4}</span>
                                )}
                            </div>

                            <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                                <span class="inline-flex items-center gap-1 tabular-nums">
                                    <Calendar size={10} />
                                    {fmtDate(r.pushedAt)}
                                </span>
                                {r.license && (
                                    <span>· {r.license}</span>
                                )}
                                {r.homepage && (
                                    <a
                                        href={r.homepage}
                                        target="_blank"
                                        rel="noopener"
                                        class="inline-flex items-center gap-1 hover:text-primary"
                                    >
                                        <ExternalLink size={10} /> homepage
                                    </a>
                                )}
                            </div>
                        </li>
                    ))}
                </ul>
            </section>
        ))}

        <footer class="pt-12 mt-12 border-t border-border text-xs text-muted-foreground">
            <p>
                分類為啟發式（描述 / 名稱 / topics 含醫療關鍵字即歸醫療），如有錯誤分類請開 issue。
                完整列表與最新狀態請見
                <a
                    href="https://github.com/htlin222"
                    target="_blank"
                    rel="noopener"
                    class="underline-offset-4 hover:underline ml-1"
                >
                    GitHub Profile
                </a>。
            </p>
        </footer>
    </main>
</Layout>
