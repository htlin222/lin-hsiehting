---
import Layout from "@/layouts/Layout.astro";
import {
    Github,
    Star,
    GitFork,
    Stethoscope,
    Code2,
    ExternalLink,
    Calendar,
    Tag,
    Search,
    Bookmark,
    BookmarkCheck,
    TvMinimalPlay,
    X,
} from "@lucide/astro";
import portfolio from "@/data/github-portfolio.json";

interface Repo {
    name: string;
    description: string;
    language: string | null;
    stars: number;
    forks: number;
    pushedAt: string;
    createdAt: string;
    topics: string[];
    url: string;
    homepage: string | null;
    license: string | null;
    defaultBranch: string;
    category: "medical" | "it";
    readmeExcerpt?: string | null;
}

const repos = portfolio.repos as Repo[];
const fetchedAt = new Date(portfolio.fetchedAt);

// Default order: newest push first (the snapshot is already sorted this way,
// but re-sort defensively so the server-rendered order matches the JS default).
const sorted = [...repos].sort(
    (a, b) => new Date(b.pushedAt).getTime() - new Date(a.pushedAt).getTime(),
);

const medicalCount = sorted.filter((r) => r.category === "medical").length;
const itCount = sorted.filter((r) => r.category === "it").length;

const fmtDate = (iso: string) => {
    const d = new Date(iso);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
};

// Build the lowercased haystack used by the client-side search box.
const searchKey = (r: Repo) =>
    [r.name, r.description, r.topics.join(" "), r.language ?? "", r.readmeExcerpt ?? ""]
        .join(" ")
        .toLowerCase();

// Stable language colour mapping (top languages only — others use the muted tone).
const langColor: Record<string, string> = {
    Python: "bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/30",
    TypeScript: "bg-sky-500/10 text-sky-700 dark:text-sky-300 border-sky-500/30",
    JavaScript: "bg-yellow-500/10 text-yellow-700 dark:text-yellow-300 border-yellow-500/30",
    R: "bg-blue-700/10 text-blue-800 dark:text-blue-300 border-blue-700/30",
    TeX: "bg-emerald-700/10 text-emerald-800 dark:text-emerald-300 border-emerald-700/30",
    Lua: "bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border-indigo-500/30",
    Shell: "bg-zinc-500/10 text-zinc-700 dark:text-zinc-300 border-zinc-500/30",
    HTML: "bg-orange-500/10 text-orange-700 dark:text-orange-300 border-orange-500/30",
    MDX: "bg-violet-500/10 text-violet-700 dark:text-violet-300 border-violet-500/30",
};

const langClass = (lang: string | null) =>
    lang && langColor[lang]
        ? langColor[lang]
        : "bg-muted text-muted-foreground border-border";

const catLabel = (c: Repo["category"]) => (c === "medical" ? "醫療" : "IT");
---

<Layout
    title="Portfolio | 林協霆 · Hsieh-Ting Lin"
    description={`${portfolio.count} 個 GitHub 開源專案，醫療 ${medicalCount} + IT ${itCount}，可搜尋、篩選與依更新／星數／Fork 排序。`}
>
    <main class="px-6 sm:px-8 max-w-5xl mx-auto pb-20">
        <header class="pt-6 pb-6 border-b border-border">
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">
                Portfolio
            </h1>
            <p class="text-muted-foreground mt-2">
                <a
                    href="https://github.com/htlin222"
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1.5 hover:text-primary transition-colors underline-offset-4 hover:underline"
                >
                    <Github size={14} /> github.com/htlin222
                </a>
                · {sorted.length} 個 repo · 醫療 {medicalCount} · IT {itCount}
            </p>
            <p class="text-xs text-muted-foreground mt-1">
                最近同步：{fmtDate(fetchedAt.toISOString())} · 每日自動更新星數／Fork
            </p>

            <!-- Control bar: search + category filter + sort -->
            <div class="mt-6 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                <div class="flex items-center gap-2 w-full lg:max-w-md">
                    <div class="relative flex-1">
                        <Search
                            size={15}
                            class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none"
                        />
                        <input
                            id="repo-search"
                            type="search"
                            placeholder="搜尋專案…"
                            data-ph-zh="搜尋專案…"
                            data-ph-en="Search projects…"
                            data-ph-ja="プロジェクトを検索…"
                            autocomplete="off"
                            class="w-full pl-9 pr-3 py-2 rounded-md border border-border bg-card text-sm outline-none focus:border-primary transition-colors"
                        />
                    </div>
                    <button
                        id="slideshow-open"
                        type="button"
                        disabled
                        aria-haspopup="dialog"
                        title="投影片播放清單 / Slideshow"
                        class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-border bg-card text-sm transition-colors hover:border-primary disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        <TvMinimalPlay size={15} />
                        <span data-lang-only="zh">投影片</span>
                        <span data-lang-only="en">Slides</span>
                        <span data-lang-only="ja">スライド</span>
                        <span
                            id="bookmark-count"
                            class="inline-flex items-center justify-center min-w-5 h-5 px-1 rounded-full bg-primary text-primary-foreground text-xs tabular-nums"
                            >0</span
                        >
                    </button>
                </div>

                <div class="flex items-center gap-2 flex-wrap">
                    <div
                        class="inline-flex rounded-md border border-border overflow-hidden"
                        role="group"
                        aria-label="分類篩選 / Filter by category"
                    >
                        <button
                            type="button"
                            data-cat-btn
                            data-cat="all"
                            aria-pressed="true"
                            class="cat-btn px-3 py-2 text-sm transition-colors"
                        >
                            <span data-lang-only="zh">全部</span>
                            <span data-lang-only="en">All</span>
                            <span data-lang-only="ja">すべて</span>
                            ({sorted.length})
                        </button>
                        <button
                            type="button"
                            data-cat-btn
                            data-cat="medical"
                            aria-pressed="false"
                            class="cat-btn px-3 py-2 text-sm transition-colors border-l border-border inline-flex items-center gap-1"
                        >
                            <Stethoscope size={13} />
                            <span data-lang-only="zh">醫療</span>
                            <span data-lang-only="en">Medical</span>
                            <span data-lang-only="ja">医療</span>
                            ({medicalCount})
                        </button>
                        <button
                            type="button"
                            data-cat-btn
                            data-cat="it"
                            aria-pressed="false"
                            class="cat-btn px-3 py-2 text-sm transition-colors border-l border-border inline-flex items-center gap-1"
                        >
                            <Code2 size={13} />
                            <span data-lang-only="zh">開發</span>
                            <span data-lang-only="en">Dev</span>
                            <span data-lang-only="ja">開発</span>
                            ({itCount})
                        </button>
                    </div>

                    <label class="inline-flex items-center gap-1.5 text-sm">
                        <span class="text-muted-foreground whitespace-nowrap">
                            <span data-lang-only="zh">排序</span>
                            <span data-lang-only="en">Sort</span>
                            <span data-lang-only="ja">並び替え</span>
                        </span>
                        <select
                            id="repo-sort"
                            class="rounded-md border border-border bg-card text-sm py-2 px-2 outline-none focus:border-primary transition-colors"
                        >
                            <option value="date" data-zh="最近更新" data-en="Recently updated" data-ja="最近の更新">最近更新</option>
                            <option value="stars" data-zh="星數" data-en="Stars" data-ja="スター数">星數</option>
                            <option value="forks" data-zh="Fork 數" data-en="Forks" data-ja="フォーク数">Fork 數</option>
                        </select>
                    </label>
                </div>
            </div>

            <p
                id="repo-count"
                class="mt-3 text-xs text-muted-foreground"
                aria-live="polite"
            >
                <span data-lang-only="zh">顯示</span><span data-lang-only="en"
                    >Showing</span
                ><span data-lang-only="ja">表示</span>
                <span id="repo-count-nums">{sorted.length} / {sorted.length}</span>
            </p>
        </header>

        <ul id="repo-grid" class="mt-6 grid gap-4 sm:grid-cols-2">
            {sorted.map((r) => (
                <li
                    data-card
                    data-name={r.name}
                    data-cat={r.category}
                    data-stars={r.stars}
                    data-forks={r.forks}
                    data-pushed={new Date(r.pushedAt).getTime()}
                    data-search={searchKey(r)}
                    class="group flex flex-col p-4 rounded-lg border border-border hover:border-primary transition-colors bg-card"
                >
                    <div class="flex items-start justify-between gap-2">
                        <h3 class="font-semibold text-base leading-tight">
                            <a
                                href={r.url}
                                target="_blank"
                                rel="noopener"
                                class="hover:text-primary inline-flex items-center gap-1"
                            >
                                {r.name}
                                <ExternalLink size={11} class="opacity-60" />
                            </a>
                        </h3>
                        <div class="shrink-0 flex items-center gap-2 text-xs text-muted-foreground tabular-nums">
                            {r.stars > 0 && (
                                <span class="inline-flex items-center gap-0.5">
                                    <Star size={11} class="text-amber-500 fill-amber-500" />
                                    {r.stars}
                                </span>
                            )}
                            {r.forks > 0 && (
                                <span class="inline-flex items-center gap-0.5">
                                    <GitFork size={11} />
                                    {r.forks}
                                </span>
                            )}
                            <button
                                type="button"
                                data-bookmark-btn
                                data-name={r.name}
                                aria-pressed="false"
                                aria-label="加入投影片 / Bookmark"
                                title="加入投影片 / Bookmark for slideshow"
                                class="bookmark-btn -my-1 -mr-1 p-1 rounded hover:text-primary transition-colors"
                            >
                                <Bookmark size={15} class="bm-off" />
                                <BookmarkCheck size={15} class="bm-on" />
                            </button>
                        </div>
                    </div>

                    {r.description && (
                        <p class="text-sm text-foreground/85 mt-1.5 leading-relaxed">
                            {r.description}
                        </p>
                    )}

                    <div class="mt-3 flex flex-wrap items-center gap-1.5 text-xs">
                        <span
                            class={`inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded border ${
                                r.category === "medical"
                                    ? "bg-rose-500/10 text-rose-700 dark:text-rose-300 border-rose-500/30"
                                    : "bg-teal-500/10 text-teal-700 dark:text-teal-300 border-teal-500/30"
                            }`}
                        >
                            {r.category === "medical" ? (
                                <Stethoscope size={9} />
                            ) : (
                                <Code2 size={9} />
                            )}
                            {catLabel(r.category)}
                        </span>
                        {r.language && (
                            <span class={`inline-flex items-center px-1.5 py-0.5 rounded border ${langClass(r.language)}`}>
                                {r.language}
                            </span>
                        )}
                        {r.topics.slice(0, 4).map((t) => (
                            <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-muted text-muted-foreground border border-border">
                                <Tag size={9} />
                                {t}
                            </span>
                        ))}
                        {r.topics.length > 4 && (
                            <span class="text-muted-foreground">+{r.topics.length - 4}</span>
                        )}
                    </div>

                    <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                        <span class="inline-flex items-center gap-1 tabular-nums">
                            <Calendar size={10} />
                            {fmtDate(r.pushedAt)}
                        </span>
                        {r.license && <span>· {r.license}</span>}
                        {r.homepage && (
                            <a
                                href={r.homepage}
                                target="_blank"
                                rel="noopener"
                                class="inline-flex items-center gap-1 hover:text-primary"
                            >
                                <ExternalLink size={10} /> homepage
                            </a>
                        )}
                    </div>
                </li>
            ))}
        </ul>

        <p
            id="repo-empty"
            hidden
            class="py-16 text-center text-sm text-muted-foreground"
        >
            <span data-lang-only="zh">沒有符合條件的專案，試試其他關鍵字或分類。</span>
            <span data-lang-only="en">No matching projects — try another keyword or category.</span>
            <span data-lang-only="ja">条件に一致するプロジェクトがありません。別のキーワードやカテゴリをお試しください。</span>
        </p>

        <!-- Slideshow builder dialog -->
        <div
            id="slideshow-dialog"
            class="fixed inset-0 z-[100] hidden items-start justify-center p-4 pt-20 sm:pt-28"
            role="dialog"
            aria-modal="true"
            aria-labelledby="slideshow-dialog-title"
        >
            <div
                id="slideshow-backdrop"
                class="absolute inset-0 bg-background/80 backdrop-blur-sm"
            >
            </div>
            <div
                class="relative w-full max-w-lg rounded-xl border border-border bg-card shadow-2xl flex flex-col max-h-[80vh]"
            >
                <div
                    class="flex items-center justify-between gap-3 px-5 py-4 border-b border-border"
                >
                    <h2
                        id="slideshow-dialog-title"
                        class="font-semibold inline-flex items-center gap-2"
                    >
                        <TvMinimalPlay size={18} />
                        <span data-lang-only="zh">投影片清單</span>
                        <span data-lang-only="en">Slideshow</span>
                        <span data-lang-only="ja">スライド一覧</span>
                    </h2>
                    <button
                        id="slideshow-close"
                        type="button"
                        aria-label="關閉 / Close"
                        class="p-1 rounded text-muted-foreground hover:text-foreground transition-colors"
                    >
                        <X size={18} />
                    </button>
                </div>
                <p class="px-5 pt-3 text-xs text-muted-foreground">
                    <span data-lang-only="zh">拖曳 ⠿ 調整順序（或用 ▲▼），✕ 移除。</span>
                    <span data-lang-only="en">Drag ⠿ to reorder (or ▲▼); ✕ to remove.</span>
                    <span data-lang-only="ja">⠿ をドラッグ（または ▲▼）で並び替え、✕ で削除。</span>
                </p>
                <ul
                    id="bookmark-list"
                    class="flex-1 overflow-y-auto p-3 flex flex-col gap-1.5"
                >
                </ul>
                <p
                    id="bookmark-empty"
                    hidden
                    class="px-5 py-10 text-center text-sm text-muted-foreground"
                >
                    <span data-lang-only="zh">尚未收藏任何專案。點卡片右上角的書籤即可加入。</span>
                    <span data-lang-only="en">No bookmarks yet — tap the bookmark on a card to add one.</span>
                    <span data-lang-only="ja">ブックマークがありません。カード右上のブックマークで追加できます。</span>
                </p>
                <div
                    class="flex items-center justify-between gap-3 px-5 py-4 border-t border-border"
                >
                    <button
                        id="slideshow-clear"
                        type="button"
                        class="text-sm text-muted-foreground hover:text-red-600 dark:hover:text-red-400 transition-colors"
                    >
                        <span data-lang-only="zh">全部清除</span>
                        <span data-lang-only="en">Clear all</span>
                        <span data-lang-only="ja">すべて削除</span>
                    </button>
                    <button
                        id="slideshow-start"
                        type="button"
                        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 transition-opacity disabled:opacity-50"
                    >
                        <TvMinimalPlay size={15} />
                        <span data-lang-only="zh">開始播放</span>
                        <span data-lang-only="en">Start slide show</span>
                        <span data-lang-only="ja">スライド開始</span>
                    </button>
                </div>
            </div>
        </div>

        <footer class="pt-12 mt-12 border-t border-border text-xs text-muted-foreground">
            <p>
                分類為啟發式（描述 / 名稱 / topics 含醫療關鍵字即歸醫療），如有錯誤分類請開 issue。
                星數與 Fork 數每日自動同步。完整列表與最新狀態請見
                <a
                    href="https://github.com/htlin222"
                    target="_blank"
                    rel="noopener"
                    class="underline-offset-4 hover:underline ml-1"
                >
                    GitHub Profile
                </a>。
            </p>
        </footer>
    </main>
</Layout>

<style>
    .cat-btn[aria-pressed="true"] {
        background-color: var(--primary);
        color: var(--primary-foreground);
    }
    .cat-btn[aria-pressed="false"] {
        color: var(--muted-foreground);
    }
    .cat-btn[aria-pressed="false"]:hover {
        color: var(--foreground);
    }

    /* Bookmark toggle: outline when off, filled check + accent when on. */
    .bookmark-btn {
        color: var(--muted-foreground);
    }
    .bookmark-btn .bm-on {
        display: none;
    }
    .bookmark-btn[aria-pressed="true"] {
        color: var(--primary);
    }
    .bookmark-btn[aria-pressed="true"] .bm-off {
        display: none;
    }
    .bookmark-btn[aria-pressed="true"] .bm-on {
        display: inline;
    }
</style>

<script>
    function currentLang() {
        const l = document.documentElement.dataset.lang;
        return l === "en" || l === "ja" ? l : "zh";
    }

    // Search placeholder + <option> text are plain attributes that cannot hold
    // data-lang-only spans, so sync them to the global UI language by hand.
    function syncPortfolioLang() {
        const lang = currentLang();
        const input = document.getElementById(
            "repo-search",
        ) as HTMLInputElement | null;
        if (input) {
            const ph = input.dataset["ph" + lang[0].toUpperCase() + lang.slice(1)];
            if (ph) input.placeholder = ph;
        }
        const sel = document.getElementById(
            "repo-sort",
        ) as HTMLSelectElement | null;
        if (sel) {
            Array.from(sel.options).forEach((o) => {
                const t = o.dataset[lang];
                if (t) o.textContent = t;
            });
        }
    }

    // <html> persists across Astro view transitions — register the lang
    // observer once so navigations never stack duplicate observers.
    if (!(window as any).__portfolioLang) {
        const obs = new MutationObserver(syncPortfolioLang);
        obs.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["data-lang"],
        });
        (window as any).__portfolioLang = obs;
    }

    const BOOKMARK_KEY = "portfolio-bookmarks";
    function readBookmarks(): string[] {
        try {
            const v = JSON.parse(localStorage.getItem(BOOKMARK_KEY) || "[]");
            return Array.isArray(v) ? v.filter((x) => typeof x === "string") : [];
        } catch {
            return [];
        }
    }
    function writeBookmarks(list: string[]) {
        try {
            localStorage.setItem(BOOKMARK_KEY, JSON.stringify(list));
        } catch {}
    }
    function escapeHtml(s: string) {
        return s.replace(
            /[&<>"']/g,
            (c) =>
                ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;",
                })[c] as string,
        );
    }

    // Esc closes the dialog — registered once (document persists across view
    // transitions); re-queries the dialog so it always targets the live one.
    if (!(window as any).__portfolioEsc) {
        (window as any).__portfolioEsc = true;
        document.addEventListener("keydown", (e) => {
            if (e.key !== "Escape") return;
            const d = document.getElementById("slideshow-dialog");
            if (d && !d.classList.contains("hidden")) {
                d.classList.add("hidden");
                d.classList.remove("flex");
                document.body.style.overflow = "";
            }
        });
    }

    function initPortfolio() {
        const grid = document.getElementById("repo-grid");
        if (!grid || grid.dataset.bound === "1") return;
        grid.dataset.bound = "1";
        const cards = Array.from(
            grid.querySelectorAll("li[data-card]"),
        ) as HTMLElement[];
        const searchInput = document.getElementById(
            "repo-search",
        ) as HTMLInputElement | null;
        const sortSelect = document.getElementById(
            "repo-sort",
        ) as HTMLSelectElement | null;
        const catButtons = Array.from(
            document.querySelectorAll("[data-cat-btn]"),
        ) as HTMLElement[];
        const numsEl = document.getElementById("repo-count-nums");
        const emptyEl = document.getElementById("repo-empty");

        let activeCat = "all";
        let query = "";
        let sortKey = "date";

        const num = (el: HTMLElement, k: string) => Number(el.dataset[k] || 0);

        function render() {
            const visible = cards.filter((c) => {
                const catOk = activeCat === "all" || c.dataset.cat === activeCat;
                const qOk = !query || (c.dataset.search || "").includes(query);
                return catOk && qOk;
            });

            visible.sort((a, b) => {
                if (sortKey === "stars")
                    return (
                        num(b, "stars") - num(a, "stars") ||
                        num(b, "pushed") - num(a, "pushed")
                    );
                if (sortKey === "forks")
                    return (
                        num(b, "forks") - num(a, "forks") ||
                        num(b, "pushed") - num(a, "pushed")
                    );
                return num(b, "pushed") - num(a, "pushed");
            });

            const visibleSet = new Set(visible);
            cards.forEach((c) => {
                c.hidden = !visibleSet.has(c);
            });
            visible.forEach((c) => grid!.appendChild(c));

            if (numsEl)
                numsEl.textContent = `${visible.length} / ${cards.length}`;
            if (emptyEl) emptyEl.hidden = visible.length > 0;
        }

        function setCat(cat: string) {
            activeCat = cat;
            catButtons.forEach((btn) => {
                btn.setAttribute(
                    "aria-pressed",
                    String(btn.dataset.cat === cat),
                );
            });
            render();
        }

        let debounce: ReturnType<typeof setTimeout>;
        searchInput?.addEventListener("input", () => {
            clearTimeout(debounce);
            debounce = setTimeout(() => {
                query = (searchInput.value || "").trim().toLowerCase();
                render();
            }, 120);
        });

        catButtons.forEach((btn) =>
            btn.addEventListener("click", () => setCat(btn.dataset.cat || "all")),
        );

        sortSelect?.addEventListener("change", () => {
            sortKey = sortSelect.value;
            render();
        });

        // ---- Bookmarks + slideshow builder ----
        const bookmarkBtns = Array.from(
            document.querySelectorAll("[data-bookmark-btn]"),
        ) as HTMLElement[];
        const slidesOpenBtn = document.getElementById(
            "slideshow-open",
        ) as HTMLButtonElement | null;
        const countBadge = document.getElementById("bookmark-count");
        const dialog = document.getElementById("slideshow-dialog");
        const backdrop = document.getElementById("slideshow-backdrop");
        const closeBtn = document.getElementById("slideshow-close");
        const clearBtn = document.getElementById("slideshow-clear");
        const startBtn = document.getElementById(
            "slideshow-start",
        ) as HTMLButtonElement | null;
        const listEl = document.getElementById("bookmark-list");
        const emptyHint = document.getElementById("bookmark-empty");

        let bookmarks = readBookmarks();

        function syncBookmarkUI() {
            const set = new Set(bookmarks);
            bookmarkBtns.forEach((b) =>
                b.setAttribute("aria-pressed", String(set.has(b.dataset.name || ""))),
            );
            if (countBadge) countBadge.textContent = String(bookmarks.length);
            if (slidesOpenBtn) slidesOpenBtn.disabled = bookmarks.length === 0;
            if (startBtn) startBtn.disabled = bookmarks.length === 0;
        }

        bookmarkBtns.forEach((b) =>
            b.addEventListener("click", () => {
                const name = b.dataset.name;
                if (!name) return;
                bookmarks = bookmarks.includes(name)
                    ? bookmarks.filter((n) => n !== name)
                    : [...bookmarks, name];
                writeBookmarks(bookmarks);
                syncBookmarkUI();
                if (dialog && !dialog.classList.contains("hidden")) renderList();
            }),
        );

        function renderList() {
            if (!listEl) return;
            listEl.innerHTML = "";
            if (emptyHint) emptyHint.hidden = bookmarks.length > 0;
            bookmarks.forEach((name, i) => {
                const li = document.createElement("li");
                li.draggable = true;
                li.dataset.index = String(i);
                li.className =
                    "flex items-center gap-2 px-2 py-2 rounded-md border border-border bg-background text-sm";
                li.innerHTML =
                    '<span class="cursor-grab select-none text-muted-foreground" aria-hidden="true">⠿</span>' +
                    '<span class="flex-1 truncate">' +
                    escapeHtml(name) +
                    "</span>" +
                    '<button type="button" data-move="up" aria-label="Move up" class="px-1 text-muted-foreground hover:text-foreground">▲</button>' +
                    '<button type="button" data-move="down" aria-label="Move down" class="px-1 text-muted-foreground hover:text-foreground">▼</button>' +
                    '<button type="button" data-remove aria-label="Remove" class="px-1 text-muted-foreground hover:text-red-500">✕</button>';
                listEl.appendChild(li);
            });
        }

        function moveItem(from: number, to: number) {
            if (to < 0 || to >= bookmarks.length || from === to) return;
            const moved = bookmarks.splice(from, 1)[0];
            bookmarks.splice(to, 0, moved);
            writeBookmarks(bookmarks);
            renderList();
            syncBookmarkUI();
        }

        listEl?.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            const li = target.closest("li[data-index]") as HTMLElement | null;
            if (!li) return;
            const i = Number(li.dataset.index);
            if (target.closest("[data-remove]")) {
                bookmarks.splice(i, 1);
                writeBookmarks(bookmarks);
                renderList();
                syncBookmarkUI();
            } else if (target.closest('[data-move="up"]')) {
                moveItem(i, i - 1);
            } else if (target.closest('[data-move="down"]')) {
                moveItem(i, i + 1);
            }
        });

        let dragFrom: number | null = null;
        listEl?.addEventListener("dragstart", (e) => {
            const li = (e.target as HTMLElement).closest(
                "li[data-index]",
            ) as HTMLElement | null;
            if (!li) return;
            dragFrom = Number(li.dataset.index);
            li.classList.add("opacity-50");
            const dt = (e as DragEvent).dataTransfer;
            if (dt) dt.effectAllowed = "move";
        });
        listEl?.addEventListener("dragend", (e) => {
            (e.target as HTMLElement)
                .closest("li[data-index]")
                ?.classList.remove("opacity-50");
        });
        listEl?.addEventListener("dragover", (e) => e.preventDefault());
        listEl?.addEventListener("drop", (e) => {
            e.preventDefault();
            const li = (e.target as HTMLElement).closest(
                "li[data-index]",
            ) as HTMLElement | null;
            if (!li || dragFrom === null) return;
            moveItem(dragFrom, Number(li.dataset.index));
            dragFrom = null;
        });

        function openDialog() {
            if (!dialog || !bookmarks.length) return;
            renderList();
            dialog.classList.remove("hidden");
            dialog.classList.add("flex");
            document.body.style.overflow = "hidden";
        }
        function closeDialog() {
            if (!dialog) return;
            dialog.classList.add("hidden");
            dialog.classList.remove("flex");
            document.body.style.overflow = "";
        }

        slidesOpenBtn?.addEventListener("click", openDialog);
        closeBtn?.addEventListener("click", closeDialog);
        backdrop?.addEventListener("click", closeDialog);
        clearBtn?.addEventListener("click", () => {
            bookmarks = [];
            writeBookmarks(bookmarks);
            renderList();
            syncBookmarkUI();
        });
        startBtn?.addEventListener("click", () => {
            if (!bookmarks.length) return;
            const q = bookmarks.map(encodeURIComponent).join(",");
            window.open(`/portfolio/show/?repos=${q}`, "_blank");
        });

        syncBookmarkUI();
        syncPortfolioLang();
        render();
    }

    initPortfolio();
    document.addEventListener("astro:page-load", initPortfolio);
</script>
