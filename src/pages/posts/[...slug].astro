---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Badge from "@/components/ui/Badge.astro";
import MobileTOC from "@/components/posts/MobileTOC.astro";
import DesktopTOC from "@/components/posts/DesktopTOC.astro";
import ShareButtons from "@/components/posts/ShareButtons.astro";
import MedicalReview from "@/components/posts/MedicalReview.astro";
import AuthorBadge from "@/components/posts/AuthorBadge.astro";
import { Image } from "astro:assets";
import { siteConfig } from "@/config";
import { parseDate } from "@/utils/date";
import { calcReadTime } from "@/utils/reading-time";

export async function getStaticPaths() {
    const allPosts = await getCollection("post");
    const posts = allPosts
        .filter((p) => !p.data.draft)
        .sort((a, b) => {
            return (
                parseDate(b.data.date).getTime() -
                parseDate(a.data.date).getTime()
            );
        });

    return posts.map((post, index) => ({
        params: { slug: post.id },
        props: {
            post,
            prevPost:
                index < posts.length - 1
                    ? {
                          id: posts[index + 1].id,
                          title: posts[index + 1].data.title,
                      }
                    : null,
            nextPost:
                index > 0
                    ? {
                          id: posts[index - 1].id,
                          title: posts[index - 1].data.title,
                      }
                    : null,
        },
    }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);

const readTime = calcReadTime(post.body!);

const dateObj = parseDate(post.data.date);
const dateFormatted = dateObj.toLocaleDateString("en-US", {
    timeZone: "UTC",
    month: "short",
    day: "numeric",
    year: "numeric",
});
const isoDate = dateObj.toISOString();

let updatedDateFormatted: string | null = null;
if (post.data.updatedDate) {
    const updatedObj = parseDate(post.data.updatedDate);
    updatedDateFormatted = updatedObj.toLocaleDateString("en-US", {
        timeZone: "UTC",
        month: "short",
        day: "numeric",
        year: "numeric",
    });
}

// Fall back to the auto-generated OG card (1200x630) when the post does not
// declare its own cover image. Path matches scripts/og-image.mjs output.
const ogImage = post.data.image?.src ?? `/og/${post.id}.png`;
const postUrl = new URL(
    Astro.url.pathname,
    Astro.site || Astro.url.origin,
).href;
const pdfUrl = `/pdf/${post.id}.pdf`;
const pdfAbsoluteUrl = new URL(pdfUrl, Astro.site || Astro.url.origin).href;
const printAbsoluteUrl = new URL(
    `/print/${post.id}`,
    Astro.site || Astro.url.origin,
).href;
const citationPubDate = (() => {
    const d = parseDate(post.data.date);
    const y = d.getUTCFullYear();
    const m = String(d.getUTCMonth() + 1).padStart(2, "0");
    const day = String(d.getUTCDate()).padStart(2, "0");
    return `${y}/${m}/${day}`;
})();

const updatedIso = post.data.updatedDate
    ? parseDate(post.data.updatedDate).toISOString()
    : isoDate;
const reviewedIso = post.data.reviewedDate
    ? parseDate(post.data.reviewedDate).toISOString()
    : updatedIso;

const schemaAuthor: Record<string, unknown> = {
    "@type": "Person",
    name: siteConfig.author.name,
};
if (siteConfig.author.specialty)
    schemaAuthor.jobTitle = siteConfig.author.specialty;
if (siteConfig.author.affiliation)
    schemaAuthor.affiliation = siteConfig.author.affiliation;
if (siteConfig.author.orcid)
    schemaAuthor.sameAs = [siteConfig.author.orcid].filter(Boolean);

const schemaReviewer: Record<string, unknown> = {
    "@type": "Person",
    name: post.data.reviewer ?? siteConfig.author.name,
};
if (post.data.reviewerCredentials)
    schemaReviewer.description = post.data.reviewerCredentials;

const blogPostingSchema: Record<string, unknown> = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    author: schemaAuthor,
    datePublished: isoDate,
    dateModified: updatedIso,
    description: post.data.frontmatter,
    inLanguage: "zh-TW",
    keywords: post.data.tags.join(", "),
    url: postUrl,
    mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
    publisher: {
        "@type": "Organization",
        name: siteConfig.title,
        url: siteConfig.siteUrl,
    },
};
if (ogImage) {
    blogPostingSchema.image = new URL(
        ogImage,
        Astro.site || Astro.url.origin,
    ).href;
}
if (post.data.doi) {
    blogPostingSchema.identifier = {
        "@type": "PropertyValue",
        propertyID: "doi",
        value: post.data.doi,
    };
    const sameAs = [`https://doi.org/${post.data.doi}`];
    if (post.data.conceptDoi && post.data.conceptDoi !== post.data.doi) {
        sameAs.push(`https://doi.org/${post.data.conceptDoi}`);
    }
    blogPostingSchema.sameAs = sameAs;
}

const medicalSchema = post.data.medical
    ? (() => {
          const schema: Record<string, unknown> = {
              "@context": "https://schema.org",
              "@type": "MedicalWebPage",
              url: postUrl,
              name: post.data.title,
              description: post.data.frontmatter,
              inLanguage: "zh-TW",
              audience: {
                  "@type": "MedicalAudience",
                  audienceType: "Patient",
              },
              author: schemaAuthor,
              reviewedBy: schemaReviewer,
              lastReviewed: reviewedIso,
              dateModified: updatedIso,
          };
          if (post.data.medicalCondition) {
              schema.about = {
                  "@type": "MedicalCondition",
                  name: post.data.medicalCondition,
              };
          }
          return schema;
      })()
    : null;

const faqSchema =
    post.data.faq && post.data.faq.length > 0
        ? {
              "@context": "https://schema.org",
              "@type": "FAQPage",
              mainEntity: post.data.faq.map((item) => ({
                  "@type": "Question",
                  name: item.q,
                  acceptedAnswer: {
                      "@type": "Answer",
                      text: item.a,
                  },
              })),
          }
        : null;

const allEntries = await getCollection("post");
const relatedPosts = allEntries
    .filter((p) => !p.data.draft && p.id !== post.id)
    .map((p) => ({
        id: p.id,
        title: p.data.title,
        frontmatter: p.data.frontmatter,
        tags: p.data.tags,
        readTime: calcReadTime(p.body!),
        sharedTags: p.data.tags.filter((t) => post.data.tags.includes(t))
            .length,
    }))
    .filter((p) => p.sharedTags > 0)
    .sort((a, b) => b.sharedTags - a.sharedTags)
    .slice(0, 3);
---

<Layout
    title={`${post.data.title} | ${siteConfig.title}`}
    description={post.data.frontmatter}
    type="article"
    image={ogImage}
>
    <Fragment slot="head">
        <meta name="citation_title" content={post.data.title} />
        {post.data.titleEn && (
            <meta name="citation_title" content={post.data.titleEn} />
        )}
        <meta name="citation_author" content="Lin, Hsieh-Ting" />
        <meta name="citation_publication_date" content={citationPubDate} />
        <meta name="citation_journal_title" content={siteConfig.titleEn} />
        <meta name="citation_language" content="zh-TW" />
        {post.data.tags && (
            <meta
                name="citation_keywords"
                content={post.data.tags.join("; ")}
            />
        )}
        {post.data.doi && (
            <meta name="citation_doi" content={post.data.doi} />
        )}
        <meta name="citation_pdf_url" content={pdfAbsoluteUrl} />
        <meta name="citation_fulltext_html_url" content={postUrl} />
        <link rel="alternate" type="application/pdf" href={pdfUrl} />
        <link
            rel="alternate"
            media="print"
            type="text/html"
            href={`/print/${post.id}`}
        />
    </Fragment>
    <div class="fixed top-0 left-0 w-full z-50 bg-transparent">
        <div
            id="progress-bar"
            class="h-0.75 bg-primary transition-all duration-150 ease-out"
            style="width: 0%"
        >
        </div>
    </div>
    <main class="page pb-20 mt-10 relative">
        <div class="mb-10 w-full">
            <a
                href="/"
                class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors flex items-center gap-2"
            >
                <span>←</span> Back to writing
            </a>
        </div>

        <article class="w-full max-w-full">
            <header class="mb-14 lg:mb-20">
                <h1
                    class="text-4xl md:text-5xl lg:text-5xl font-bold tracking-tight mb-6 text-foreground leading-tight"
                >
                    {post.data.title}
                </h1>
                <div
                    class="flex items-center gap-2 text-sm text-muted-foreground mb-4 flex-wrap"
                >
                    <time datetime={isoDate}>{dateFormatted}</time>
                    {
                        updatedDateFormatted && (
                            <>
                                <span>·</span>
                                <span class="italic">
                                    Updated {updatedDateFormatted}
                                </span>
                            </>
                        )
                    }
                    <span>·</span>
                    <span>{readTime} min read</span>
                    <span>·</span>
                    <div class="flex gap-2 flex-wrap">
                        {
                            post.data.tags.map((tag: string) => (
                                <Badge
                                    content={tag}
                                    href={`/tags/${tag}`}
                                />
                            ))
                        }
                    </div>
                </div>
                <div class="mb-6 flex flex-wrap items-center gap-3">
                    <AuthorBadge />
                    <ShareButtons url={postUrl} title={post.data.title} />
                </div>
                {
                    post.data.image && (
                        <Image
                            src={post.data.image}
                            alt={post.data.title}
                            class="w-full h-auto rounded-xl mt-8 object-cover aspect-video border border-border"
                            loading="eager"
                            fetchpriority="high"
                        />
                    )
                }
            </header>
        </article>

        <div class="flex flex-col lg:flex-row gap-10 relative">
            <div class="flex-1 w-full max-w-full">
                <div class="prose-blog">
                    <div class="drop-cap">
                        <Content />
                    </div>
                </div>
                {
                    post.data.medical && (
                        <MedicalReview
                            reviewer={post.data.reviewer}
                            reviewerCredentials={post.data.reviewerCredentials}
                            reviewedDate={post.data.reviewedDate}
                            lastUpdated={post.data.updatedDate ?? post.data.date}
                            medicalCondition={post.data.medicalCondition}
                            title={post.data.title}
                            titleEn={post.data.titleEn}
                            date={post.data.date}
                            doi={post.data.doi}
                            conceptDoi={post.data.conceptDoi}
                            pdfUrl={pdfUrl}
                        />
                    )
                }
            </div>

            {headings.length > 0 && <DesktopTOC headings={headings} />}
        </div>

        <div class="mt-16 pt-8 border-t border-border">
            <span
                class="text-xs uppercase tracking-widest text-muted-foreground mb-4 block"
                >Share this post</span
            >
            <ShareButtons url={postUrl} title={post.data.title} />
        </div>

        {
            relatedPosts.length > 0 && (
                <div class="mt-16">
                    <span class="text-xs uppercase tracking-widest text-muted-foreground mb-6 block">
                        Related posts
                    </span>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        {relatedPosts.map((related) => (
                            <a
                                href={`/posts/${related.id}`}
                                class="group p-4 border border-border rounded-lg hover:bg-muted transition-colors"
                            >
                                <h3 class="font-medium group-hover:text-primary transition-colors line-clamp-2">
                                    {related.title}
                                </h3>
                                <p class="text-sm text-muted-foreground mt-2 line-clamp-2">
                                    {related.frontmatter}
                                </p>
                                <span class="text-xs text-muted-foreground mt-2 block">
                                    {related.readTime} min read
                                </span>
                            </a>
                        ))}
                    </div>
                </div>
            )
        }

        <nav class="mt-16 pt-8 border-t border-border grid grid-cols-2 gap-4">
            <div>
                {
                    prevPost && (
                        <a
                            href={`/posts/${prevPost.id}`}
                            class="group flex flex-col gap-1"
                        >
                            <span class="text-xs text-muted-foreground">
                                ← Older
                            </span>
                            <span class="text-sm font-medium group-hover:text-primary transition-colors line-clamp-1">
                                {prevPost.title}
                            </span>
                        </a>
                    )
                }
            </div>
            <div class="text-right">
                {
                    nextPost && (
                        <a
                            href={`/posts/${nextPost.id}`}
                            class="group flex flex-col gap-1 items-end"
                        >
                            <span class="text-xs text-muted-foreground">
                                Newer →
                            </span>
                            <span class="text-sm font-medium group-hover:text-primary transition-colors line-clamp-1">
                                {nextPost.title}
                            </span>
                        </a>
                    )
                }
            </div>
        </nav>

        <div class="mt-10 flex justify-center">
            <a
                href="/"
                class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors flex items-center gap-2"
            >
                ← Back to writing
            </a>
        </div>
    </main>

    {headings.length > 0 && <MobileTOC headings={headings} />}
    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(blogPostingSchema)}
    />
    {
        medicalSchema && (
            <script
                is:inline
                type="application/ld+json"
                set:html={JSON.stringify(medicalSchema)}
            />
        )
    }
    {
        faqSchema && (
            <script
                is:inline
                type="application/ld+json"
                set:html={JSON.stringify(faqSchema)}
            />
        )
    }

    <script is:inline>
        let onScroll = null;
        let observer = null;

        document.addEventListener(
            "astro:before-swap",
            () => {
                if (onScroll) {
                    window.removeEventListener("scroll", onScroll);
                    onScroll = null;
                }
                if (observer) {
                    observer.disconnect();
                    observer = null;
                }
            },
            { once: true },
        );

        document.addEventListener("astro:page-load", () => {
            onScroll = () => {
                const winScroll =
                    document.body.scrollTop ||
                    document.documentElement.scrollTop;
                const height =
                    document.documentElement.scrollHeight -
                    document.documentElement.clientHeight;
                const scrolled = height <= 0 ? 100 : (winScroll / height) * 100;
                const progressBar = document.getElementById("progress-bar");
                if (progressBar) {
                    progressBar.style.width = scrolled + "%";
                }
            };

            window.addEventListener("scroll", onScroll);

            const activeLiClasses = [
                "border-l-2",
                "border-primary",
                "-ml-[1px]",
            ];
            const activeLinkClasses = ["text-foreground", "font-medium"];

            const activeHeadings = new Set();

            observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        const id = entry.target.getAttribute("id");
                        if (entry.isIntersecting) {
                            activeHeadings.add(id);
                        } else {
                            activeHeadings.delete(id);
                        }
                    });

                    const headers = Array.from(
                        document.querySelectorAll("h2, h3, h4"),
                    );
                    const firstActive = headers.find((h) =>
                        activeHeadings.has(h.getAttribute("id")),
                    );

                    if (firstActive) {
                        const id = firstActive.getAttribute("id");
                        const desktopLink = document.querySelector(
                            `aside a[href="#${id}"]`,
                        );
                        const mobileLink = document.querySelector(
                            `#mobile-toc-menu a[href="#${id}"]`,
                        );

                        document.querySelectorAll("aside li").forEach((el) => {
                            el.classList.remove(...activeLiClasses);
                            const a = el.querySelector("a");
                            if (a) {
                                a.classList.remove(...activeLinkClasses);
                                a.classList.add("text-muted-foreground");
                            }
                        });

                        document
                            .querySelectorAll("#mobile-toc-menu li")
                            .forEach((el) => {
                                el.classList.remove(...activeLiClasses);
                                const a = el.querySelector("a");
                                if (a) {
                                    a.classList.remove(...activeLinkClasses);
                                    a.classList.add("text-muted-foreground");
                                }
                            });

                        if (desktopLink) {
                            const asideLi = desktopLink.parentElement;
                            asideLi.classList.add(...activeLiClasses);
                            desktopLink.classList.add(...activeLinkClasses);
                            desktopLink.classList.remove(
                                "text-muted-foreground",
                            );
                        }

                        if (mobileLink) {
                            const mobileLi = mobileLink.parentElement;
                            mobileLi.classList.add(...activeLiClasses);
                            mobileLink.classList.add(...activeLinkClasses);
                            mobileLink.classList.remove(
                                "text-muted-foreground",
                            );
                        }
                    }
                },
                { rootMargin: "0px 0px -80% 0px" },
            );

            document.querySelectorAll("h2, h3, h4").forEach((header) => {
                observer.observe(header);
            });
        });
    </script>
</Layout>
